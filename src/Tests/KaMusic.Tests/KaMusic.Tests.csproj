<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Cell.ImageId 只在未链接进测试工程的 TerminalRenderer 里赋值。 -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Apps/KugouAvaloniaPlayer/Services/DesktopLyric/WaylandLyricProtocol.cs" Link="Lyrics/WaylandLyricProtocol.cs" />
    <Compile Include="../../Libraries/KuGou.Net/Protocol/Session/KgSession.cs" Link="Session/KgSession.cs" />
    <Compile Include="../../Libraries/KuGou.Net/Protocol/Session/SessionPersistence.cs" Link="Session/SessionPersistence.cs" />
    <Compile Include="../../Apps/KaMusic.Cli/Services/TerminalSessionPersistence.cs" Link="Session/TerminalSessionPersistence.cs" />
    <!-- 歌单分页与播放队列顺序的纯逻辑（不依赖网络/音频）。 -->
    <Compile Include="../../Apps/KaMusic.Cli/Services/TerminalPlaylistPaging.cs" Link="Playlist/TerminalPlaylistPaging.cs" />
    <!-- 终端颜色深度与 SGR 编码（Linux TTY 只有 16 色）。 -->
    <Compile Include="../../Apps/KaMusic.Cli/Graphics/TerminalCapabilities.cs" Link="Terminal/TerminalCapabilities.cs" />
    <Compile Include="../../Apps/KaMusic.Cli/Tui/Ansi.cs" Link="Terminal/Ansi.cs" />
    <Compile Include="../../Apps/KaMusic.Cli/Tui/TuiPrimitives.cs" Link="Terminal/TuiPrimitives.cs" />
    <Compile Include="../../Apps/KaMusic.Cli/Tui/Theme.cs" Link="Terminal/Theme.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../../Libraries/AvaloniaSilkEffects/AvaloniaSilkEffects.csproj" />
    <ProjectReference Include="../../Libraries/AvaloniaLyrics/AvaloniaLyrics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Apps/KugouAvaloniaPlayer/Views/NowPlayingThemes/NowPlayingLyricSnapshot.cs" Link="Lyrics/NowPlayingLyricSnapshot.cs" />
    <!-- Compile the VM-independent Fume adapter without building the player. -->
    <Compile Include="../../Apps/KugouAvaloniaPlayer/Controls/FumeBackgroundScene.cs" Link="Fume/FumeBackgroundScene.cs" />
    <Compile Include="../../Apps/KugouAvaloniaPlayer/Controls/FumeArticleLayout.cs" Link="Fume/FumeArticleLayout.cs" />
    <Compile Include="../../Apps/KugouAvaloniaPlayer/Controls/FumeRenderFrame.cs" Link="Fume/FumeRenderFrame.cs" />
    <Compile Include="../../Apps/KugouAvaloniaPlayer/Controls/FumePlayback.cs" Link="Fume/FumePlayback.cs" />
    <Compile Include="../../Apps/KugouAvaloniaPlayer/Controls/FumeEffectScene.cs" Link="Fume/FumeEffectScene.cs" />
  </ItemGroup>
</Project>
