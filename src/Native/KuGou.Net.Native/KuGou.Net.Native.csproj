<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <Features Condition="'$(TargetFramework)' == 'net11.0'">$(Features);runtime-async=on</Features>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <OutputType>Library</OutputType>
        <PublishAot>true</PublishAot>

        <StripSymbols>true</StripSymbols>


        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' Or $(RuntimeIdentifier.StartsWith('android-'))">
        <DefineConstants>$(DefineConstants);ANDROID</DefineConstants>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Libraries\KuGou.Net\KuGou.Net.csproj"/>
    </ItemGroup>

    <ItemGroup Condition="'$(AndroidJniBootstrapLibrary)' != ''">
        <DirectPInvoke Include="KuGou.Android.JniBootstrap" />
        <NativeLibrary Include="$(AndroidJniBootstrapLibrary)" />
    </ItemGroup>

</Project>
