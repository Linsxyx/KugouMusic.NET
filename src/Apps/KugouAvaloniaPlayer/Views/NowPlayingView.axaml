<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
             xmlns:behaviors="using:KugouAvaloniaPlayer.Behaviors"
             xmlns:vm="using:KugouAvaloniaPlayer.ViewModels"
             xmlns:models="clr-namespace:KugouAvaloniaPlayer.Models"
             x:Class="KugouAvaloniaPlayer.Views.NowPlayingView"
             x:DataType="vm:NowPlayingViewModel">

    <UserControl.Styles>
        <Style Selector="Grid#Root">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.32" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid#Root.open">
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Grid#NowPlayingForeground">
            <Setter Property="RenderTransform" Value="translateY(72px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.48" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid#NowPlayingForeground.open">
            <Setter Property="RenderTransform" Value="translateY(0)" />
        </Style>

        <Style Selector="Image.NowPlayingBackgroundLayer">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.7" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBlock.ParallaxLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#DDFFFFFF" />
        </Style>
        <Style Selector="TextBlock.ParallaxValue">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Monospace" />
            <Setter Property="Foreground" Value="#B8E5B96B" />
        </Style>
        <Style Selector="Button.ParallaxSegment">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="#DDFFFFFF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style Selector="Button.ParallaxSegment:pointerover">
            <Setter Property="Background" Value="#25E5B96B" />
        </Style>
    </UserControl.Styles>

    <Grid Name="Root"
          Classes.open="{Binding IsOpen}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ClipToBounds="True">
        <Panel>
            <Image behaviors:LocalArtworkImageBehavior.Source="{Binding Player.PreparedNextCover}"
                                 behaviors:LocalArtworkImageBehavior.DecodePixelWidth="320"
                                 behaviors:LocalArtworkImageBehavior.UseDefaultFallback="False"
                                 behaviors:LocalArtworkImageBehavior.IsEnabled="{Binding IsOpen}"
                                 behaviors:NowPlayingRemoteImageBehavior.Source="{Binding Player.PreparedNextCover, Converter={StaticResource RemoteImageSourceConverter}}"
                                 behaviors:NowPlayingRemoteImageBehavior.IsEnabled="{Binding IsOpen}"
                                 Width="1"
                                 Height="1"
                                 Opacity="0"
                                 IsHitTestVisible="False"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top" />
            <Border Background="#FF000000" />
            <Panel x:Name="SharedBackgroundFrame"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   ClipToBounds="False"
                   IsHitTestVisible="False">
                <Image x:Name="BackgroundSourceImage"
                       behaviors:LocalArtworkImageBehavior.Source="{Binding NowPlayingBackgroundImageSource}"
                       behaviors:LocalArtworkImageBehavior.DecodePixelWidth="960"
                       behaviors:LocalArtworkImageBehavior.DecodeInterpolationMode="HighQuality"
                       behaviors:LocalArtworkImageBehavior.IsEnabled="{Binding IsOpen}"
                       behaviors:NowPlayingRemoteImageBehavior.Source="{Binding NowPlayingBackgroundImageSource, Converter={StaticResource RemoteImageSourceConverter}}"
                       behaviors:NowPlayingRemoteImageBehavior.IsEnabled="{Binding IsOpen}"
                       Width="1"
                       Height="1"
                       Opacity="0"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />
                <Image x:Name="CachedBackgroundImage"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       Stretch="UniformToFill"
                       Margin="-96"
                       Opacity="{Binding BackgroundImageOpacity}"
                       Classes="NowPlayingBackgroundLayer" />
                <Image behaviors:NowPlayingRemoteImageBehavior.Source="{Binding PortraitBackgroundA, Converter={StaticResource RemoteImageSourceConverter}}"
                       behaviors:NowPlayingRemoteImageBehavior.IsEnabled="{Binding IsOpen}"
                       Stretch="UniformToFill"
                       Margin="-96"
                       Opacity="{Binding PortraitLayerAOpacity}"
                       Classes="NowPlayingBackgroundLayer" />
                <Image behaviors:NowPlayingRemoteImageBehavior.Source="{Binding PortraitBackgroundB, Converter={StaticResource RemoteImageSourceConverter}}"
                       behaviors:NowPlayingRemoteImageBehavior.IsEnabled="{Binding IsOpen}"
                       Stretch="UniformToFill"
                       Margin="-96"
                       Opacity="{Binding PortraitLayerBOpacity}"
                       Classes="NowPlayingBackgroundLayer" />
            </Panel>

            <Border Background="#33000000" />
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#24000000" Offset="0" />
                        <GradientStop Color="#64000000" Offset="0.48" />
                        <GradientStop Color="#90000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Panel>

        <Grid x:Name="ThemeContentHost" />

        <Border Height="72"
                VerticalAlignment="Top"
                Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="TitleBar" />
        <Grid x:Name="NowPlayingForeground"
              Classes.open="{Binding IsOpen}"
              RowDefinitions="Auto, *"
              Margin="40">
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*"
                  Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            HorizontalAlignment="Left">
                    <Button Cursor="Hand"
                            Command="{Binding CloseCommand}"
                            Classes="Basic">
                        <Border Background="#30FFFFFF" CornerRadius="20" Padding="15,8">
                            <PathIcon Data="{x:Static suki:Icons.ChevronDown}" Foreground="White" Width="15" Height="15" />
                        </Border>
                    </Button>

                    <Button Cursor="Hand"
                            Command="{Binding CycleThemePresetCommand}"
                            Classes="Basic"
                            PointerEntered="ShowModeConfigurationFlyout">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout Placement="Bottom"
                                    OverlayInputPassThroughElement="{Binding $parent}" 
                                    ShowMode="TransientWithDismissOnPointerMoveAway">
                                <Border Background="#E5141B2A"
                                        BorderBrush="#2EE5B96B"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="18"
                                        BoxShadow="0 18 50 0 #66000000"
                                        IsVisible="{Binding SelectedThemePreset,Converter={x:Static ObjectConverters.NotEqual},ConverterParameter={x:Static models:NowPlayingThemePreset.Standard}}">
                                    <StackPanel Spacing="16" Width="300">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="视差设置"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="White" />
                                                <TextBlock Text="鼠标倾斜 · 响应 · 枢轴"
                                                           FontSize="11"
                                                           Foreground="#8FFFFFFF" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="Basic ParallaxSegment"
                                                    Command="{Binding ActiveParallaxTuning.ResetCommand}"
                                                    Content="恢复默认"
                                                    Cursor="Hand"
                                                    IsEnabled="{Binding ActiveParallaxTuning.Enabled}" />
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock Classes="ParallaxLabel"
                                                       Text="启用视差效果"
                                                       VerticalAlignment="Center" />
                                            <ToggleSwitch Grid.Column="1"
                                                          IsChecked="{Binding ActiveParallaxTuning.Enabled, Mode=TwoWay}" />
                                        </Grid>

                                        <Border IsEnabled="{Binding ActiveParallaxTuning.Enabled}">
                                            <StackPanel Spacing="16">
                                                <StackPanel Spacing="7">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="ParallaxLabel" Text="最大倾斜角度" />
                                                        <TextBlock Grid.Column="1"
                                                                   Classes="ParallaxValue"
                                                                   Text="{Binding ActiveParallaxTuning.MaxTilt, StringFormat={}{0:F0}°}" />
                                                    </Grid>
                                                    <Slider Minimum="0"
                                                            Maximum="30"
                                                            TickFrequency="1"
                                                            Value="{Binding ActiveParallaxTuning.MaxTilt}"
                                                            Classes="Player PlayerDark PlayerCompact" />
                                                </StackPanel>

                                                <StackPanel Spacing="7">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="ParallaxLabel" Text="响应速度" />
                                                        <TextBlock Grid.Column="1"
                                                                   Classes="ParallaxValue"
                                                                   Text="{Binding ActiveParallaxTuning.Response, StringFormat={}{0:F1}}" />
                                                    </Grid>
                                                    <Slider Minimum="0.5"
                                                            Maximum="20"
                                                            TickFrequency="0.5"
                                                            Value="{Binding ActiveParallaxTuning.Response}"
                                                            Classes="Player PlayerDark PlayerCompact" />
                                                </StackPanel>

                                                <StackPanel Spacing="7">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="ParallaxLabel" Text="中心 X" />
                                                        <TextBlock Grid.Column="1"
                                                                   Classes="ParallaxValue"
                                                                   Text="{Binding ActiveParallaxTuning.OriginX, StringFormat={}{0:P0}}" />
                                                    </Grid>
                                                    <Slider Minimum="0"
                                                            Maximum="1"
                                                            TickFrequency="0.01"
                                                            Value="{Binding ActiveParallaxTuning.OriginX}"
                                                            Classes="Player PlayerDark PlayerCompact" />
                                                </StackPanel>

                                                <StackPanel Spacing="7">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="ParallaxLabel" Text="中心 Y" />
                                                        <TextBlock Grid.Column="1"
                                                                   Classes="ParallaxValue"
                                                                   Text="{Binding ActiveParallaxTuning.OriginY, StringFormat={}{0:P0}}" />
                                                    </Grid>
                                                    <Slider Minimum="0"
                                                            Maximum="1"
                                                            TickFrequency="0.01"
                                                            Value="{Binding ActiveParallaxTuning.OriginY}"
                                                            Classes="Player PlayerDark PlayerCompact" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        <Border Background="#24101822"
                                BorderBrush="#35E5B96B"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="13,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Svg Path="/Assets/gear-svgrepo-com.svg"
                                     Css="path { stroke: #E5B96B; fill: none; }"
                                     Width="14"
                                     Height="14"
                                     Opacity="0.92" />
                                <TextBlock Text="{Binding CurrentThemePresetName}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,-100,-25,0"
                            HorizontalAlignment="Right">
                    <Button Classes="Basic"
                            Cursor="Hand"
                            Command="{Binding RequestWindowToggleFullScreenCommand}">
                        <PathIcon Data="{x:Static suki:Icons.WindowFullScreen}"
                                  Foreground="White"
                                  Width="13"
                                  Height="13" />
                    </Button>
                    <Button Classes="Basic"
                            Cursor="Hand"
                            Command="{Binding RequestWindowMinimizeCommand}">
                        <PathIcon Data="{x:Static suki:Icons.WindowMinimize}"
                                  Foreground="White"
                                  Width="13"
                                  Height="13"
                                  Margin="0,0,0,4" />
                    </Button>
                    <Button Classes="Basic"
                            Cursor="Hand"
                            Command="{Binding RequestWindowToggleMaximizeCommand}">
                        <PathIcon Data="{x:Static suki:Icons.WindowMaximize}"
                                  Foreground="White"
                                  Width="13"
                                  Height="13" />
                    </Button>
                    <Button Classes="Basic"
                            Cursor="Hand"
                            Command="{Binding RequestWindowCloseCommand}">
                        <PathIcon Data="{x:Static suki:Icons.WindowClose}"
                                  Foreground="White"
                                  Width="13"
                                  Height="13" />
                    </Button>
                </StackPanel>
            </Grid>


        </Grid>
    </Grid>
</UserControl>
