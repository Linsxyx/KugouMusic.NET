<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:KugouAvaloniaPlayer.ViewModels" xmlns:suki="https://github.com/kikipoulet/SukiUI" xmlns:localControls="using:KugouAvaloniaPlayer.Controls" xmlns:models="clr-namespace:KugouAvaloniaPlayer.Models" xmlns:simpleAudio="clr-namespace:SimpleAudio;assembly=SimpleAudio" xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia" xmlns:behaviors="using:KugouAvaloniaPlayer.Behaviors" x:Class="KugouAvaloniaPlayer.Views.Settings.PlayerLyricsSection" x:Name="UserRoot" x:DataType="vm:SettingViewModel">
    <StackPanel Spacing="16">
        <Border BorderBrush="{DynamicResource SukiBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
            <localControls:SettingsRow ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6">
                <StackPanel>
                    <TextBlock Text="显示频谱" FontWeight="Normal" TextWrapping="Wrap"/>
                    <TextBlock Text="显示在播放页进度条下方。" FontSize="12" Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableNowPlayingVisualizer, Mode=TwoWay}"/>
            </localControls:SettingsRow>
        </Border>
        <Border BorderBrush="{DynamicResource SukiBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
            <localControls:SettingsRow ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6">
                <TextBlock Text="调整颜色" FontWeight="Normal" TextWrapping="Wrap"/>
                <ComboBox Grid.Column="1" MinWidth="120" ItemsSource="{Binding LyricColorTargetOptions}" SelectedItem="{Binding PlayPageSelectedLyricColorTarget}" MaxWidth="300"/>
            </localControls:SettingsRow>
        </Border>
        <Border BorderBrush="{DynamicResource SukiBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
            <localControls:SettingsRow ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6">
                <TextBlock Text="颜色模式" FontWeight="Normal" TextWrapping="Wrap"/>
                <ComboBox Grid.Column="1" MinWidth="120" ItemsSource="{Binding LyricColorModeOptions}" SelectedItem="{Binding PlayPageSelectedLyricColorMode}" MaxWidth="300"/>
            </localControls:SettingsRow>
        </Border>
        <StackPanel IsVisible="{Binding IsPlayPageLyricColorCustomMode}" Spacing="8" Margin="0,4,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource SukiBorder}" Background="{Binding PlayPageLyricColorPreviewBrush}"/>
                <TextBox Grid.Column="1" PlaceholderText="#FFFFFFFF" Text="{Binding PlayPageLyricColorHexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="2" Command="{Binding ApplyPlayPageLyricColorHexCommand}" Content="应用" MinWidth="72"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding LyricColorPalette}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="x:String">
                        <Button Width="24" Height="24" Margin="3" Padding="0" CornerRadius="12" Background="{Binding .}" BorderThickness="1" BorderBrush="{DynamicResource SukiBorder}" Command="{Binding #UserRoot.((vm:SettingViewModel)DataContext).PickPlayPageLyricPaletteColorCommand}" CommandParameter="{Binding .}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <TextBlock Text="{Binding PlayPageColorError}" IsVisible="{Binding HasPlayPageColorError}" Foreground="{DynamicResource SukiRed}" FontSize="12" TextWrapping="Wrap"/>
        <Border Height="1" Background="{DynamicResource SukiBorder}" Margin="0,6"/>
        <Border BorderBrush="{DynamicResource SukiBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
            <localControls:SettingsRow ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6">
                <StackPanel>
                    <TextBlock Text="字体模式" FontWeight="Normal" TextWrapping="Wrap"/>
                    <TextBlock Text="歌词与翻译共用字体。" FontSize="12" Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap"/>
                </StackPanel>
                <ComboBox Grid.Column="1" MinWidth="120" ItemsSource="{Binding LyricFontModeOptions}" SelectedItem="{Binding PlayPageSelectedLyricFontMode}" MaxWidth="300"/>
            </localControls:SettingsRow>
        </Border>
        <StackPanel IsVisible="{Binding IsPlayPageLyricFontCustomMode}" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="字体" FontWeight="Normal" TextWrapping="Wrap"/>
            <ComboBox ItemsSource="{Binding LyricFontFamilyOptions}" SelectedItem="{Binding PlayPageSelectedLyricFontFamily}" MaxWidth="300">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="x:String">
                        <TextBlock Text="{Binding .}" FontFamily="{Binding .}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <Border Height="1" Background="{DynamicResource SukiBorder}" Margin="0,6"/>
        <Border BorderBrush="{DynamicResource SukiBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
            <localControls:SettingsRow ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6">
                <TextBlock Text="关闭上升动效" FontWeight="Normal" TextWrapping="Wrap"/>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseLightweightNowPlayingLyricScroll, Mode=TwoWay}"/>
            </localControls:SettingsRow>
        </Border>
        <Border Height="1" Background="{DynamicResource SukiBorder}" Margin="0,6"/>
        <Border Height="1" Background="{DynamicResource SukiBorder}" Margin="0,6"/>
        <Border BorderBrush="{DynamicResource SukiBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
            <localControls:SettingsRow ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6">
                <TextBlock Text="字号" FontWeight="Normal" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" Text="{Binding PlayPageLyricFontSizeDisplay}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </localControls:SettingsRow>
        </Border>
        <Slider Minimum="18" Maximum="42" Value="{Binding PlayPageLyricFontSize, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,4" Classes="Player" MaxWidth="300"/>
        <Border Height="1" Background="{DynamicResource SukiBorder}" Margin="0,6"/>
        <Border BorderBrush="{DynamicResource SukiBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
            <localControls:SettingsRow ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,6">
                <TextBlock Text="对齐方式" FontWeight="Normal" TextWrapping="Wrap"/>
                <ComboBox Grid.Column="1" MinWidth="120" ItemsSource="{Binding LyricAlignmentOptions}" SelectedItem="{Binding PlayPageSelectedLyricAlignment}" MaxWidth="300"/>
            </localControls:SettingsRow>
        </Border>
    </StackPanel>
</UserControl>
