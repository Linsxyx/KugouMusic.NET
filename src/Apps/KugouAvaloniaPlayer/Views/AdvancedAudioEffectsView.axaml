<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:KugouAvaloniaPlayer.ViewModels" x:Class="KugouAvaloniaPlayer.Views.AdvancedAudioEffectsView" x:DataType="vm:AdvancedAudioEffectsViewModel">
  <ScrollViewer MaxHeight="720" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" Margin="4" MinWidth="340">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><StackPanel><TextBlock Text="进阶音效" FontSize="20" FontWeight="Bold"/><TextBlock Text="实时预览，参数会自动保存" Opacity=".65"/><TextBlock Text="{Binding EnabledSummary}" FontSize="12" Opacity=".65"/><TextBlock Text="{Binding ImportExportStatus}" FontSize="12" Opacity=".75"/></StackPanel><WrapPanel Grid.Column="1" HorizontalAlignment="Right"><Button Margin="2" Content="导入 · Import" Command="{Binding ImportPresetCommand}"/><Button Margin="2" Content="导出 · Export" Command="{Binding ExportPresetCommand}"/><Button Margin="2" Content="全部禁用" Command="{Binding DisableAllCommand}"/><Button Margin="2" Content="恢复默认" Command="{Binding ResetCommand}"/></WrapPanel></Grid>
      <TextBlock Text="空间" FontSize="16" FontWeight="SemiBold"/>
      <Border Classes="Card"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="立体声宽度"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding StereoEnabled}"/></Grid><Slider Minimum="0" Maximum="1" HorizontalAlignment="Stretch" Value="{Binding StereoWidth}"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="混响"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding ReverbEnabled}"/></Grid><Slider Minimum="0" Maximum="1" HorizontalAlignment="Stretch" Value="{Binding ReverbAmount}"/><TextBlock Text="混响时间 (ms)"/><Slider Minimum="100" Maximum="3000" HorizontalAlignment="Stretch" Value="{Binding ReverbTimeMs}"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="回声"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding EchoEnabled}"/></Grid><TextBlock Text="回声混合 · Mix"/><Slider Minimum="0" Maximum="1" HorizontalAlignment="Stretch" Value="{Binding EchoMix}"/><TextBlock Text="回声反馈 · Feedback"/><Slider Maximum=".95" HorizontalAlignment="Stretch" Value="{Binding EchoFeedback}"/><TextBlock Text="回声延迟 · Delay (ms)"/><Slider Minimum="1" Maximum="1000" HorizontalAlignment="Stretch" Value="{Binding EchoDelayMs}"/></StackPanel></Border>
      <TextBlock Text="调制" FontSize="16" FontWeight="SemiBold"/>
      <Border Classes="Card"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="合唱 · Chorus"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding ChorusEnabled}"/></Grid><TextBlock Text="混合 · Mix"/><Slider Maximum="1" Value="{Binding ChorusMix}"/><TextBlock Text="深度 · Depth"/><Slider Maximum="100" Value="{Binding ChorusDepth}"/><TextBlock Text="速率 · Rate"/><Slider Minimum=".01" Maximum="10" Value="{Binding ChorusRate}"/></StackPanel></Border>
      <TextBlock Text="动态与音色" FontSize="16" FontWeight="SemiBold"/>
      <Border Classes="Card"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="压缩器 · Compressor"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding CompressorEnabled}"/></Grid><TextBlock Text="阈值 · Threshold"/><Slider Minimum="-60" Maximum="0" Value="{Binding CompressorThreshold}"/><TextBlock Text="比例 · Ratio"/><Slider Minimum="1" Maximum="20" Value="{Binding CompressorRatio}"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="失真 · Distortion"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding DistortionEnabled}"/></Grid><TextBlock Text="驱动 · Drive"/><Slider Maximum="1" Value="{Binding DistortionDrive}"/><TextBlock Text="混合 · Mix"/><Slider Maximum="1" Value="{Binding DistortionMix}"/></StackPanel></Border>
      <TextBlock Text="滤波" FontSize="16" FontWeight="SemiBold"/>
      <Border Classes="Card"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="参数滤波 · BQF"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding BqfEnabled}"/></Grid><TextBlock Text="中心频率 · Frequency (Hz)"/><Slider Minimum="20" Maximum="20000" Value="{Binding BqfCenterHz}"/><TextBlock Text="增益 · Gain (dB)"/><Slider Minimum="-24" Maximum="24" Value="{Binding BqfGainDb}"/><TextBlock Text="Q 值 · Resonance"/><Slider Minimum=".1" Maximum="10" Value="{Binding BqfQ}"/></StackPanel></Border>
      <TextBlock Text="更多调制 · Modulation" FontSize="16" FontWeight="SemiBold"/>
      <Border Classes="Card"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="镶边 · Flanger"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding FlangerEnabled}"/></Grid><TextBlock Text="混合 · Mix"/><Slider Maximum="1" Value="{Binding FlangerMix}"/><TextBlock Text="深度 · Depth"/><Slider Maximum="100" Value="{Binding FlangerDepth}"/><TextBlock Text="速率 · Rate"/><Slider Maximum="10" Value="{Binding FlangerRate}"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="相位 · Phaser"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding PhaserEnabled}"/></Grid><TextBlock Text="混合 · Mix"/><Slider Maximum="1" Value="{Binding PhaserMix}"/><TextBlock Text="速率 · Rate"/><Slider Maximum="10" Value="{Binding PhaserRate}"/><TextBlock Text="范围 · Range"/><Slider Maximum="10" Value="{Binding PhaserRange}"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="自动 Wah · AutoWah"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoWahEnabled}"/></Grid><TextBlock Text="混合 · Mix"/><Slider Maximum="1" Value="{Binding AutoWahMix}"/><TextBlock Text="速率 · Rate"/><Slider Maximum="10" Value="{Binding AutoWahRate}"/><TextBlock Text="频率 · Frequency"/><Slider Minimum="20" Maximum="20000" Value="{Binding AutoWahFrequency}"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="门限动态 · Damp"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding DampEnabled}"/></Grid><TextBlock Text="目标 · Target"/><Slider Maximum="1" Value="{Binding DampTarget}"/><TextBlock Text="增益 · Gain"/><Slider Maximum="2" Value="{Binding DampGain}"/><TextBlock Text="延迟 · Delay (ms)"/><Slider Maximum="1000" Value="{Binding DampDelay}"/></StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
