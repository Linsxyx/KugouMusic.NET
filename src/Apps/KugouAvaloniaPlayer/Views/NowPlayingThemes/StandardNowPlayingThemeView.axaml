<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vela="using:Vela.Avalonia.Controls"
             xmlns:kc="clr-namespace:KugouAvaloniaPlayer.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="using:KugouAvaloniaPlayer.Behaviors"
             xmlns:vm="using:KugouAvaloniaPlayer.ViewModels"
             xmlns:lyrics="clr-namespace:AvaloniaLyrics;assembly=AvaloniaLyrics"
             xmlns:controls="using:KugouAvaloniaPlayer.Controls"
             x:Class="KugouAvaloniaPlayer.Views.NowPlayingThemes.StandardNowPlayingThemeView"
             x:DataType="vm:NowPlayingViewModel">

    <UserControl.Styles>
        <Style Selector="StackPanel#AlbumMotionContainer">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.NowPlayingTransportBtn">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.NowPlayingTransportBtn /template/ Border#PART_StateLayer">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.NowPlayingTransportBtn:pointerover">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <Style Selector="Button.NowPlayingTransportBtn:pressed">
            <Setter Property="Background" Value="#32FFFFFF" />
            <Setter Property="RenderTransform" Value="scale(0.95)" />
        </Style>

        <Style Selector="Button.NowPlayingPlayHeroBtn">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="25" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.NowPlayingPlayHeroBtn /template/ Border#PART_StateLayer">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.NowPlayingPlayHeroBtn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.07)" />
        </Style>
        <Style Selector="Button.NowPlayingPlayHeroBtn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.94)" />
        </Style>

        <Style Selector="Button.NowPlayingPortraitBtn">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.NowPlayingPortraitBtn /template/ Border#PART_StateLayer">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.NowPlayingPortraitBtn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <Style Selector="Button.NowPlayingPortraitBtn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)" />
        </Style>
        <Style Selector="Border.PortraitActiveRing">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.PortraitActiveRing.active">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <ThemeVariantScope RequestedThemeVariant="Dark">
        <Grid x:Name="StandardThemeRoot">
            <Grid IsHitTestVisible="False"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  RowDefinitions="*,Auto"
                  Opacity="0.68"
                  IsVisible="{Binding Player.IsNowPlayingVisualizerEnabled}">
                <Border Grid.Row="1"
                        Height="170"
                        Margin="-80,0,-80,-30"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        IsHitTestVisible="False"
                        Opacity="0.2">
                    <Border.Background>
                        <RadialGradientBrush Center="50%,100%"
                                             GradientOrigin="50%,100%"
                                             RadiusX="0.82"
                                             RadiusY="0.72">
                            <GradientStop Color="#00FFFFFF" Offset="0.0" />
                            <GradientStop Color="#22FFFFFF" Offset="0.35" />
                            <GradientStop Color="#42FFFFFF" Offset="0.66" />
                            <GradientStop Color="#00FFFFFF" Offset="1.0" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Border Grid.Row="1"
                        Height="1"
                        Margin="-40,0,-40,28"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Opacity="0.18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#00FFFFFF" Offset="0.0" />
                            <GradientStop Color="#C8FFFFFF" Offset="0.5" />
                            <GradientStop Color="#00FFFFFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <controls:AudioVisualizerControl
                    Grid.Row="1"
                    Height="235"
                    Margin="-20,0,-20,-24"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Player="{Binding Player}" />
            </Grid>

            <!-- 写真模式按钮：38x38 GPU 毛玻璃圆形按钮，对齐左上角收起按钮正下方 -->
            <Button Command="{Binding TogglePortraitModeCommand}"
                    Classes="NowPlayingPortraitBtn"
                    ToolTip.Tip="写真模式"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="40,98,0,0">
                <Panel>
                    <vela:VelaGlassCard Width="38"
                                        Height="38"
                                        CornerRadius="19"
                                        Padding="0"
                                        BlurRadius="36"
                                        TintLevel="Standard">
                        <kc:KugouIcon Path="/Assets/portrait-mode.svg"
                                      Foreground="White"
                                      Width="20"
                                      Height="20"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Opacity="0.92" />
                    </vela:VelaGlassCard>
                    <Border Classes="PortraitActiveRing"
                            Classes.active="{Binding IsPortraitModeEnabled}"
                            CornerRadius="19"
                            BorderThickness="1.5"
                            BorderBrush="{DynamicResource VelaAccentBrush}"
                            Background="#283B82F6"
                            IsHitTestVisible="False" />
                </Panel>
            </Button>

            <Grid ColumnDefinitions="4*, 6*"
                  Margin="40,120,40,68">
                <StackPanel Grid.Column="0"
                            x:Name="AlbumMotionContainer"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="28"
                            IsVisible="{Binding IsStandardLayoutVisible}"
                            Opacity="{Binding Player.NowPlayingArtworkOpacity}">
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="{Binding Player.NowPlayingArtworkTranslateY}">
                            <TranslateTransform.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Y" Duration="0:0:0.28" Easing="CubicEaseOut" />
                                </Transitions>
                            </TranslateTransform.Transitions>
                        </TranslateTransform>
                    </StackPanel.RenderTransform>

                    <!-- 封面玻璃相框 -->
                    <vela:VelaGlassCard CornerRadius="22"
                                        Padding="0"
                                        BlurBackground="False"
                                        Width="320"
                                        Height="320"
                                        MinWidth="220"
                                        MinHeight="220"
                                        MaxWidth="350"
                                        MaxHeight="350">
                        <Image behaviors:LocalArtworkImageBehavior.Source="{Binding Player.DisplayedPlayingSong.Cover}"
                               behaviors:LocalArtworkImageBehavior.DecodePixelWidth="512"
                               behaviors:LocalArtworkImageBehavior.DecodeInterpolationMode="HighQuality"
                               behaviors:LocalArtworkImageBehavior.IsEnabled="{Binding IsOpen}"
                               behaviors:NowPlayingRemoteImageBehavior.Source="{Binding Player.DisplayedPlayingSong.Cover, Converter={StaticResource RemoteImageSourceConverter}}"
                               behaviors:NowPlayingRemoteImageBehavior.IsEnabled="{Binding IsOpen}"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               Stretch="UniformToFill" />
                    </vela:VelaGlassCard>

                    <!-- 歌曲信息 + 弹性进度条 + 玻璃播控区 -->
                    <StackPanel Spacing="14"
                                Width="320"
                                HorizontalAlignment="Center">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Player.DisplayedPlayingSong.Name}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Player.DisplayedPlayingSong.Singer}"
                                       FontSize="16"
                                       Foreground="#CCFFFFFF"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- VelaElasticSlider 弹性进度条 + 等宽时间戳 -->
                        <StackPanel Spacing="2">
                            <vela:VelaElasticSlider Minimum="0"
                                                    Maximum="{Binding Player.TotalDurationSeconds}"
                                                    Value="{Binding Player.CurrentPositionSeconds, Mode=TwoWay}"
                                                    Step="0.1"
                                                    Margin="-12,0"
                                                    HorizontalAlignment="Stretch"
                                                    Classes="MediaProgress MediaDark" />
                            <Grid ColumnDefinitions="*,*">
                                <TextBlock Text="{Binding Player.CurrentPositionSeconds, Converter={StaticResource SecondsToTimeConverter}}"
                                           FontSize="11.5"
                                           FontFeatures="+tnum"
                                           Foreground="#A8FFFFFF"
                                           HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Player.TotalDurationSeconds, Converter={StaticResource SecondsToTimeConverter}}"
                                           FontSize="11.5"
                                           FontFeatures="+tnum"
                                           Foreground="#A8FFFFFF"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <!-- 播控行：喜欢 / 上一首 / 玻璃播放暂停 / 下一首 / 独立音量玻璃弹层 -->
                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto"
                              Margin="2,2,2,0">
                            <Button Grid.Column="0"
                                    Command="{Binding Player.ToggleLikeCommand}"
                                    Classes="NowPlayingTransportBtn"
                                    ToolTip.Tip="添加到我喜欢">
                                <Panel>
                                    <kc:KugouIcon Path="/Assets/FavoriteBorder.svg"
                                                  Foreground="#FF4D5E"
                                                  Width="19"
                                                  Height="19"
                                                  IsVisible="{Binding Player.IsLiked}" />
                                    <kc:KugouIcon Path="/Assets/FavoriteBorder.svg"
                                                  Foreground="White"
                                                  Opacity="0.7"
                                                  Width="19"
                                                  Height="19"
                                                  IsVisible="{Binding !Player.IsLiked}" />
                                </Panel>
                            </Button>

                            <Button Grid.Column="2"
                                    Command="{Binding Player.PlayPreviousCommand}"
                                    Classes="NowPlayingTransportBtn"
                                    ToolTip.Tip="上一首">
                                <kc:KugouIcon Path="/Assets/backward.svg"
                                              Foreground="White"
                                              Width="18"
                                              Height="18" />
                            </Button>

                            <Button Grid.Column="4"
                                    Command="{Binding Player.TogglePlayPauseCommand}"
                                    Classes="NowPlayingPlayHeroBtn"
                                    ToolTip.Tip="播放 / 暂停">
                                <vela:VelaGlassCard Width="50"
                                                    Height="50"
                                                    CornerRadius="25"
                                                    Padding="0"
                                                    BlurRadius="32"
                                                    TintLevel="Standard">
                                    <Panel>
                                        <kc:KugouIcon Path="/Assets/pause-1006-svgrepo-com.svg"
                                                      Width="22"
                                                      Height="22"
                                                      Foreground="White"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsVisible="{Binding Player.IsPlayingAudio}" />
                                        <kc:KugouIcon Path="/Assets/play-1003-svgrepo-com.svg"
                                                      Width="22"
                                                      Height="22"
                                                      Margin="2,0,0,0"
                                                      Foreground="White"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsVisible="{Binding !Player.IsPlayingAudio}" />
                                    </Panel>
                                </vela:VelaGlassCard>
                            </Button>

                            <Button Grid.Column="6"
                                    Command="{Binding Player.PlayNextCommand}"
                                    Classes="NowPlayingTransportBtn"
                                    ToolTip.Tip="下一首">
                                <kc:KugouIcon Path="/Assets/next-svgrepo-com.svg"
                                              Foreground="White"
                                              Width="18"
                                              Height="18" />
                            </Button>

                            <Button Grid.Column="8"
                                    x:Name="VolumeTriggerButton"
                                    Classes="NowPlayingTransportBtn"
                                    ToolTip.Tip="音量调节"
                                    PointerWheelChanged="VolumeButton_OnPointerWheelChanged">
                                <Button.Flyout>
                                    <Flyout Placement="TopEdgeAlignedRight"
                                            VerticalOffset="-8"
                                            FlyoutPresenterTheme="{StaticResource TransparentFlyoutPresenterTheme}">
                                        <ThemeVariantScope RequestedThemeVariant="Dark">
                                            <vela:VelaGlassCard Width="236"
                                                                CornerRadius="18"
                                                                Padding="12,10"
                                                                BlurRadius="40"
                                                                TintLevel="HighContrast">
                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                      ColumnSpacing="8"
                                                      VerticalAlignment="Center">
                                                    <Button Classes="NowPlayingTransportBtn"
                                                            Width="28"
                                                            Height="28"
                                                            ToolTip.Tip="静音 / 取消静音"
                                                            Click="VolumeMuteButton_OnClick">
                                                        <Panel>
                                                            <kc:KugouIcon Path="/Assets/VolumeUp.svg"
                                                                          Foreground="White"
                                                                          Width="16"
                                                                          Height="16"
                                                                          Opacity="0.9"
                                                                          IsVisible="{Binding !Player.IsMuted}" />
                                                            <kc:KugouIcon Path="/Assets/VolumeOff.svg"
                                                                          Foreground="White"
                                                                          Width="16"
                                                                          Height="16"
                                                                          Opacity="0.65"
                                                                          IsVisible="{Binding Player.IsMuted}" />
                                                        </Panel>
                                                    </Button>

                                                    <vela:VelaElasticSlider Grid.Column="1"
                                                                            Minimum="0"
                                                                            Maximum="1"
                                                                            Step="0.01"
                                                                            Value="{Binding Player.MusicVolume, Mode=TwoWay}"
                                                                            Classes="MediaVolume MediaDark Compact"
                                                                            VerticalAlignment="Center"
                                                                            PointerWheelChanged="VolumeButton_OnPointerWheelChanged" />

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Player.MusicVolume, StringFormat='{}{0:P0}'}"
                                                               FontSize="11.5"
                                                               FontFeatures="+tnum"
                                                               Width="36"
                                                               TextAlignment="Right"
                                                               Foreground="#CCFFFFFF"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </vela:VelaGlassCard>
                                        </ThemeVariantScope>
                                    </Flyout>
                                </Button.Flyout>
                                <Panel>
                                    <kc:KugouIcon Path="/Assets/VolumeUp.svg"
                                                  Foreground="White"
                                                  Width="18"
                                                  Height="18"
                                                  Opacity="0.86"
                                                  IsVisible="{Binding !Player.IsMuted}" />
                                    <kc:KugouIcon Path="/Assets/VolumeOff.svg"
                                                  Foreground="White"
                                                  Width="18"
                                                  Height="18"
                                                  Opacity="0.65"
                                                  IsVisible="{Binding Player.IsMuted}" />
                                </Panel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <lyrics:LyricView x:Name="LyricScrollView"
                                  Grid.Column="{Binding LyricsGridColumn}"
                                  Grid.ColumnSpan="{Binding LyricsGridColumnSpan}"
                                  Lines="{Binding Player.RenderLyricLines}"
                                  Position="{Binding Player.CurrentPosition}"
                                  IsPositionClockRunning="{Binding Player.IsPlayingAudio}"
                                  SeekCommand="{Binding Player.SeekToLyricLineCommand}"
                                  IsActive="{Binding IsOpen}"
                                  Preset="AppleMusicClassic"
                                  UseLightweightScrollAnimation="{Binding UseLightweightLyricScroll}"
                                  Margin="{Binding LyricsMargin}"
                                  ShowTranslation="{Binding IsTranslationVisible}"
                                  ShowRomanization="{Binding IsRomanizationVisible}"
                                  FontFamily="{Binding LyricFontFamily}"
                                  TextAlignment="{Binding LyricTextAlignment}"
                                  PrimaryFontSize="{Binding LyricFontSize}"
                                  TranslationFontSize="{Binding TranslationFontSize}"
                                  RomanizationFontSize="{Binding TranslationFontSize}"
                                  PrimaryForeground="{Binding LyricForeground}"
                                  PrimaryPlayedForeground="{Binding LyricForeground}"
                                  TranslationForeground="{Binding TranslationLineForeground}"
                                  TranslationPlayedForeground="{Binding TranslationWordForeground}"
                                  RomanizationForeground="{Binding TranslationLineForeground}"
                                  Opacity="{Binding Player.NowPlayingLyricsOpacity}">
                    <lyrics:LyricView.RenderTransform>
                        <TranslateTransform Y="{Binding Player.NowPlayingLyricsTranslateY}">
                            <TranslateTransform.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Y" Duration="0:0:0.32" Easing="CubicEaseOut" />
                                </Transitions>
                            </TranslateTransform.Transitions>
                        </TranslateTransform>
                    </lyrics:LyricView.RenderTransform>
                </lyrics:LyricView>

                <TextBlock Grid.Column="{Binding LyricsGridColumn}"
                           Grid.ColumnSpan="{Binding LyricsGridColumnSpan}"
                           Text="暂无歌词"
                           IsVisible="{Binding !Player.LyricLines.Count}"
                           Foreground="White"
                           Opacity="0.5"
                           FontSize="24"
                           FontWeight="ExtraLight"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- 右下角 VelaGlassMenu：原位毛玻璃形变菜单（歌词模式子菜单 / 歌手跳转子菜单 / 写真模式 / 添加到歌单） -->
            <vela:VelaGlassMenu x:Name="MoreGlassMenu"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,28,26"
                                TriggerSize="44"
                                MenuWidth="236"
                                MenuCornerRadius="18"
                                BlurRadius="44"
                                TintLevel="Standard"
                                ToolTip.Tip="更多操作" />
        </Grid>
    </ThemeVariantScope>
</UserControl>
