<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vela="using:Vela.Avalonia.Controls"
             xmlns:kc="clr-namespace:KugouAvaloniaPlayer.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:KugouAvaloniaPlayer.Controls"
             xmlns:vm="using:KugouAvaloniaPlayer.ViewModels"
             x:Class="KugouAvaloniaPlayer.Views.NowPlayingThemes.PendoloNowPlayingThemeView"
             x:DataType="vm:NowPlayingViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.PendoloSettingsLabel">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#DDE6F5FF" />
        </Style>
        <Style Selector="TextBlock.PendoloSettingsValue">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontFeatures" Value="+tnum" />
            <Setter Property="Foreground" Value="#C867B9DB" />
        </Style>
        <Style Selector="Button.ThemeGearTrigger">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ThemeGearTrigger /template/ Border#PART_StateLayer">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.ThemeGearTrigger:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <Style Selector="Button.ThemeGearTrigger:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)" />
        </Style>
    </UserControl.Styles>

    <ThemeVariantScope RequestedThemeVariant="Dark">
        <Grid ClipToBounds="True">
            <controls:PendoloVisualizerControl
                Player="{Binding Player}"
                IsActive="{Binding IsOpen}"
                ShowTranslation="{Binding IsTranslationVisible}"
                ShowRomanization="{Binding IsRomanizationVisible}"
                LyricFontFamily="{Binding LyricFontFamily}"
                LyricColor="{Binding LyricColor}"
                TranslationColor="{Binding TranslationColor}"
                ParallaxEnabled="{Binding PendoloParallaxTuning.Enabled}"
                ParallaxMaxTilt="{Binding PendoloParallaxTuning.MaxTilt}"
                ParallaxResponse="{Binding PendoloParallaxTuning.Response}"
                ParallaxOriginX="{Binding PendoloParallaxTuning.OriginX}"
                ParallaxOriginY="{Binding PendoloParallaxTuning.OriginY}" />

            <controls:FloatingPlayerBar Classes="Pendolo"
                                        Margin="0,0,0,26"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom" />

            <Button Classes="ThemeGearTrigger"
                    Margin="0,0,28,26"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    ToolTip.Tip="Pendolo 视差参数">
                <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedRight"
                            VerticalOffset="-10"
                            FlyoutPresenterTheme="{StaticResource TransparentFlyoutPresenterTheme}">
                        <ThemeVariantScope RequestedThemeVariant="Dark">
                            <vela:VelaGlassCard Width="336"
                                                CornerRadius="20"
                                                Padding="18"
                                                BlurRadius="44"
                                                TintLevel="HighContrast">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Pendolo 视差"
                                                       FontSize="15.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFE6F5FF" />
                                            <TextBlock Text="鼠标倾斜、响应与视觉中心"
                                                       FontSize="11.5"
                                                       Foreground="#8FE6F5FF" />
                                        </StackPanel>
                                        <vela:VelaButton Grid.Column="1"
                                                         Variant="Secondary"
                                                         Size="Small"
                                                         Command="{Binding PendoloParallaxTuning.ResetCommand}"
                                                         Content="恢复默认"
                                                         IsEnabled="{Binding PendoloParallaxTuning.Enabled}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Classes="PendoloSettingsLabel"
                                                   Text="启用视差效果"
                                                   VerticalAlignment="Center" />
                                        <vela:VelaSwitch Grid.Column="1"
                                                         IsChecked="{Binding PendoloParallaxTuning.Enabled, Mode=TwoWay}" />
                                    </Grid>

                                    <Border IsEnabled="{Binding PendoloParallaxTuning.Enabled}">
                                        <StackPanel Spacing="12">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Classes="PendoloSettingsLabel" Text="最大倾斜角度" />
                                                    <TextBlock Grid.Column="1"
                                                               Classes="PendoloSettingsValue"
                                                               Text="{Binding PendoloParallaxTuning.MaxTilt, StringFormat={}{0:F0}°}" />
                                                </Grid>
                                                <vela:VelaElasticSlider Classes="Inline MediaDark"
                                                                        Minimum="0"
                                                                        Maximum="30"
                                                                        Step="1"
                                                                        ValueSuffix="°"
                                                                        Value="{Binding PendoloParallaxTuning.MaxTilt, Mode=TwoWay}" />
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Classes="PendoloSettingsLabel" Text="响应速度" />
                                                    <TextBlock Grid.Column="1"
                                                               Classes="PendoloSettingsValue"
                                                               Text="{Binding PendoloParallaxTuning.Response, StringFormat={}{0:F1}}" />
                                                </Grid>
                                                <vela:VelaElasticSlider Classes="Inline MediaDark"
                                                                        Minimum="0.5"
                                                                        Maximum="20"
                                                                        Step="0.5"
                                                                        Value="{Binding PendoloParallaxTuning.Response, Mode=TwoWay}" />
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Classes="PendoloSettingsLabel" Text="中心 X" />
                                                    <TextBlock Grid.Column="1"
                                                               Classes="PendoloSettingsValue"
                                                               Text="{Binding PendoloParallaxTuning.OriginX, StringFormat={}{0:P0}}" />
                                                </Grid>
                                                <vela:VelaElasticSlider Classes="InlinePercent MediaDark"
                                                                        Minimum="0"
                                                                        Maximum="1"
                                                                        Step="0.01"
                                                                        Value="{Binding PendoloParallaxTuning.OriginX, Mode=TwoWay}" />
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Classes="PendoloSettingsLabel" Text="中心 Y" />
                                                    <TextBlock Grid.Column="1"
                                                               Classes="PendoloSettingsValue"
                                                               Text="{Binding PendoloParallaxTuning.OriginY, StringFormat={}{0:P0}}" />
                                                </Grid>
                                                <vela:VelaElasticSlider Classes="InlinePercent MediaDark"
                                                                        Minimum="0"
                                                                        Maximum="1"
                                                                        Step="0.01"
                                                                        Value="{Binding PendoloParallaxTuning.OriginY, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </vela:VelaGlassCard>
                        </ThemeVariantScope>
                    </Flyout>
                </Button.Flyout>

                <vela:VelaGlassCard Width="44"
                                    Height="44"
                                    CornerRadius="22"
                                    Padding="0"
                                    BlurRadius="36"
                                    TintLevel="Standard">
                    <PathIcon Data="{DynamicResource VelaIconSliders}"
                              Foreground="#E6F5FF"
                              Width="17"
                              Height="17"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </vela:VelaGlassCard>
            </Button>
        </Grid>
    </ThemeVariantScope>
</UserControl>
