<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vela="using:Vela.Avalonia.Controls"
             xmlns:kc="clr-namespace:KugouAvaloniaPlayer.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KugouAvaloniaPlayer.ViewModels" xmlns:models="using:KugouAvaloniaPlayer.Models"
             xmlns:sections="using:KugouAvaloniaPlayer.Views.Settings"
             xmlns:local="using:KugouAvaloniaPlayer.Controls"
             x:Class="KugouAvaloniaPlayer.Views.SettingView" x:Name="UserRoot" x:DataType="vm:SettingViewModel">
    <UserControl.Styles><StyleInclude Source="/Views/Settings/SettingsStyles.axaml" /></UserControl.Styles>
    <kc:KugouGlassCard Margin="16,16,16,100" Padding="20">
        <Grid x:Name="LayoutGrid" ColumnDefinitions="116,*" ColumnSpacing="20">
            <Grid x:Name="SideNavigation" RowDefinitions="Auto,*">
                <StackPanel Margin="0,2,0,12" Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="设置" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="偏好设置" FontSize="11" Opacity="0.55" HorizontalAlignment="Center" />
                </StackPanel>
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                    <vela:VelaDockBar x:Name="CategoryDock"
                                      Orientation="Vertical"
                                      DockWidth="82"
                                      ShowSearch="False"
                                      ShowShadow="False"
                                      Material="Solid"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Top"
                                      Margin="4,4,4,12" />
                </ScrollViewer>
            </Grid>
            <Grid Grid.Column="1" x:Name="ContentGrid" RowDefinitions="Auto,*" RowSpacing="18" MaxWidth="880">
                <StackPanel Spacing="16" Margin="0,2,8,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Classes="HeaderIconTile"><PathIcon Data="{Binding SelectedCategory.Icon}" /></Border>
                        <StackPanel Grid.Column="1" x:Name="CategoryHeading" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding SelectedCategory.Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedCategory.Description}" FontSize="12" Foreground="{DynamicResource SukiLowText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <vela:VelaSelect Size="Small" Grid.Column="1" x:Name="CompactNavigation" Classes="SettingsCategoryPicker" IsVisible="False" MaxWidth="Infinity" HorizontalAlignment="Stretch" VerticalAlignment="Center" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                            <vela:VelaSelect.ItemTemplate><DataTemplate x:DataType="models:SettingsCategory"><TextBlock Text="{Binding Title}" /></DataTemplate></vela:VelaSelect.ItemTemplate>
                        </vela:VelaSelect>
                        <Button Grid.Column="2" Classes="Basic EscapeBackButton" ToolTip.Tip="返回" VerticalAlignment="Center" Command="{Binding $parent[local:KugouWindow].((vm:MainWindowViewModel)DataContext).NavigateBackCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" Width="14" Height="14" />
                                <TextBlock Text="返回" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Classes="SettingsTabs" IsVisible="{Binding IsLyricsSection}">
                        <ListBox Classes="SettingsTabs" ItemsSource="{Binding LyricSections}" SelectedItem="{Binding SelectedLyricSection}">
                            <ListBox.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Classes="TabText" Text="{Binding .}" /></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
                <ScrollViewer Grid.Row="1" x:Name="ContentScroll" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,8">
                    <StackPanel>
                        <sections:AppearanceSection IsVisible="{Binding IsAppearanceSection}" />
                        <sections:PlaybackSection IsVisible="{Binding IsPlaybackSection}" />
                        <StackPanel IsVisible="{Binding IsLyricsSection}">
                            <sections:PlayerLyricsSection IsVisible="{Binding IsPlayerLyrics}" />
                            <sections:DesktopLyricsSection IsVisible="{Binding IsDesktopLyrics}" />
                            <sections:TaskbarLyricsSection IsVisible="{Binding IsTaskbarLyrics}" />
                        </StackPanel>
                        <sections:ShortcutsSection IsVisible="{Binding IsShortcutsSection}" />
                        <sections:GeneralSection IsVisible="{Binding IsGeneralSection}" />
                        <sections:AboutSection IsVisible="{Binding IsUpdateSection}" />
                        <sections:AccountSection IsVisible="{Binding IsAccountSection}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </kc:KugouGlassCard>
</UserControl>
