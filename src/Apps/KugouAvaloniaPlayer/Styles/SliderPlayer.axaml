<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vela="using:Vela.Avalonia.Controls">

    <Styles.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="PlayerSliderDarkTrackBrush" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="PlayerSliderDarkFillBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="PlayerSliderDarkThumbBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="PlayerSliderDarkBubbleBgBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="PlayerSliderDarkBubbleFgBrush" Color="#FF111827" />
        </ResourceDictionary>
    </Styles.Resources>

    <!-- =========================================================================
         VelaElasticSlider: Inline Settings Variant (no header row; preserves
         elastic rubber-band overscroll, spring track thicken & tilted value bubble)
         ========================================================================= -->
    <Style Selector="vela|VelaElasticSlider.Inline">
        <Setter Property="ShowValue" Value="False" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid x:Name="PART_HitArea"
                      Height="28"
                      Background="Transparent"
                      Cursor="Hand"
                      ClipToBounds="False">

                    <Border x:Name="PART_Bubble"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="0,-30,0,0"
                            MinHeight="26"
                            Padding="10,0"
                            CornerRadius="{StaticResource VelaRadiusPill}"
                            Background="{DynamicResource VelaForegroundBrush}"
                            BoxShadow="{DynamicResource VelaShadowRaised}"
                            IsHitTestVisible="False"
                            ZIndex="20">
                        <TextBlock Text="{TemplateBinding FormattedValue}"
                                   Foreground="{DynamicResource VelaBackgroundBrush}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   FontFeatures="+tnum"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <Grid Margin="12,0" Height="6" VerticalAlignment="Center" ClipToBounds="False">
                        <Border x:Name="PART_Track"
                                CornerRadius="{StaticResource VelaRadiusPill}"
                                Background="{DynamicResource VelaControlTrackBrush}"
                                ClipToBounds="True">
                            <Border x:Name="PART_Fill"
                                    HorizontalAlignment="Left"
                                    CornerRadius="{StaticResource VelaRadiusPill}"
                                    Background="{DynamicResource VelaControlFillBrush}" />
                        </Border>
                        <Canvas x:Name="PART_Ticks" IsHitTestVisible="False" />
                    </Grid>

                    <!-- Outer 24x24 matches VelaElasticSlider.ThumbSize so center aligns pixel-for-pixel with track ends -->
                    <Border x:Name="PART_Thumb"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Width="24"
                            Height="24"
                            Background="Transparent"
                            IsHitTestVisible="False">
                        <Border x:Name="PART_ThumbVisual"
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="{StaticResource VelaRadiusPill}"
                                Background="{DynamicResource VelaControlThumbBrush}"
                                BoxShadow="{DynamicResource VelaControlThumbShadow}" />
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Inline percentage bubble variant (0..1 -> 0%..100%) -->
    <Style Selector="vela|VelaElasticSlider.InlinePercent">
        <Setter Property="ShowValue" Value="False" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid x:Name="PART_HitArea"
                      Height="28"
                      Background="Transparent"
                      Cursor="Hand"
                      ClipToBounds="False">

                    <Border x:Name="PART_Bubble"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="0,-30,0,0"
                            MinHeight="26"
                            Padding="10,0"
                            CornerRadius="{StaticResource VelaRadiusPill}"
                            Background="{DynamicResource VelaForegroundBrush}"
                            BoxShadow="{DynamicResource VelaShadowRaised}"
                            IsHitTestVisible="False"
                            ZIndex="20">
                        <TextBlock Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:P0}'}"
                                   Foreground="{DynamicResource VelaBackgroundBrush}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   FontFeatures="+tnum"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <Grid Margin="12,0" Height="6" VerticalAlignment="Center" ClipToBounds="False">
                        <Border x:Name="PART_Track"
                                CornerRadius="{StaticResource VelaRadiusPill}"
                                Background="{DynamicResource VelaControlTrackBrush}"
                                ClipToBounds="True">
                            <Border x:Name="PART_Fill"
                                    HorizontalAlignment="Left"
                                    CornerRadius="{StaticResource VelaRadiusPill}"
                                    Background="{DynamicResource VelaControlFillBrush}" />
                        </Border>
                        <Canvas x:Name="PART_Ticks" IsHitTestVisible="False" />
                    </Grid>

                    <Border x:Name="PART_Thumb"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Width="24"
                            Height="24"
                            Background="Transparent"
                            IsHitTestVisible="False">
                        <Border x:Name="PART_ThumbVisual"
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="{StaticResource VelaRadiusPill}"
                                Background="{DynamicResource VelaControlThumbBrush}"
                                BoxShadow="{DynamicResource VelaControlThumbShadow}" />
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- =========================================================================
         VelaElasticSlider: Media Playback Progress Bar (elastic stretch + mm:ss bubble)
         ========================================================================= -->
    <Style Selector="vela|VelaElasticSlider.MediaProgress">
        <Setter Property="ShowValue" Value="False" />
        <Setter Property="Step" Value="0.1" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid x:Name="PART_HitArea"
                      Height="24"
                      Background="Transparent"
                      Cursor="Hand"
                      ClipToBounds="False">

                    <Border x:Name="PART_Bubble"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="0,-30,0,0"
                            MinHeight="24"
                            Padding="9,0"
                            CornerRadius="{StaticResource VelaRadiusPill}"
                            Background="{DynamicResource VelaForegroundBrush}"
                            BoxShadow="{DynamicResource VelaShadowRaised}"
                            IsHitTestVisible="False"
                            ZIndex="20">
                        <TextBlock x:Name="PART_BubbleText"
                                   Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SecondsToTimeConverter}}"
                                   Foreground="{DynamicResource VelaBackgroundBrush}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   FontFeatures="+tnum"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <Grid Margin="12,0" Height="5" VerticalAlignment="Center" ClipToBounds="False">
                        <Border x:Name="PART_Track"
                                CornerRadius="{StaticResource VelaRadiusPill}"
                                Background="{DynamicResource VelaControlTrackBrush}"
                                ClipToBounds="True">
                            <Border x:Name="PART_Fill"
                                    HorizontalAlignment="Left"
                                    CornerRadius="{StaticResource VelaRadiusPill}"
                                    Background="{DynamicResource VelaControlFillBrush}" />
                        </Border>
                        <Canvas x:Name="PART_Ticks" IsHitTestVisible="False" />
                    </Grid>

                    <Border x:Name="PART_Thumb"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Width="24"
                            Height="24"
                            Background="Transparent"
                            IsHitTestVisible="False">
                        <Border x:Name="PART_ThumbVisual"
                                Width="14"
                                Height="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="{StaticResource VelaRadiusPill}"
                                Background="{DynamicResource VelaControlThumbBrush}"
                                BoxShadow="{DynamicResource VelaControlThumbShadow}" />
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- =========================================================================
         VelaElasticSlider: Horizontal Media Volume Bar (elastic stretch + % bubble)
         ========================================================================= -->
    <Style Selector="vela|VelaElasticSlider.MediaVolume">
        <Setter Property="ShowValue" Value="False" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Step" Value="0.01" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid x:Name="PART_HitArea"
                      Height="24"
                      Background="Transparent"
                      Cursor="Hand"
                      ClipToBounds="False">

                    <Border x:Name="PART_Bubble"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="0,-30,0,0"
                            MinHeight="24"
                            Padding="9,0"
                            CornerRadius="{StaticResource VelaRadiusPill}"
                            Background="{DynamicResource VelaForegroundBrush}"
                            BoxShadow="{DynamicResource VelaShadowRaised}"
                            IsHitTestVisible="False"
                            ZIndex="20">
                        <TextBlock x:Name="PART_BubbleText"
                                   Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:P0}'}"
                                   Foreground="{DynamicResource VelaBackgroundBrush}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   FontFeatures="+tnum"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <Grid Margin="12,0" Height="5" VerticalAlignment="Center" ClipToBounds="False">
                        <Border x:Name="PART_Track"
                                CornerRadius="{StaticResource VelaRadiusPill}"
                                Background="{DynamicResource VelaControlTrackBrush}"
                                ClipToBounds="True">
                            <Border x:Name="PART_Fill"
                                    HorizontalAlignment="Left"
                                    CornerRadius="{StaticResource VelaRadiusPill}"
                                    Background="{DynamicResource VelaControlFillBrush}" />
                        </Border>
                        <Canvas x:Name="PART_Ticks" IsHitTestVisible="False" />
                    </Grid>

                    <Border x:Name="PART_Thumb"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Width="24"
                            Height="24"
                            Background="Transparent"
                            IsHitTestVisible="False">
                        <Border x:Name="PART_ThumbVisual"
                                Width="14"
                                Height="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="{StaticResource VelaRadiusPill}"
                                Background="{DynamicResource VelaControlThumbBrush}"
                                BoxShadow="{DynamicResource VelaControlThumbShadow}" />
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- High-contrast light-on-dark glass modifier for immersive NowPlaying surfaces -->
    <Style Selector="vela|VelaElasticSlider.MediaDark /template/ Border#PART_Track">
        <Setter Property="Background" Value="{StaticResource PlayerSliderDarkTrackBrush}" />
    </Style>
    <Style Selector="vela|VelaElasticSlider.MediaDark /template/ Border#PART_Fill">
        <Setter Property="Background" Value="{StaticResource PlayerSliderDarkFillBrush}" />
    </Style>
    <Style Selector="vela|VelaElasticSlider.MediaDark /template/ Border#PART_ThumbVisual">
        <Setter Property="Background" Value="{StaticResource PlayerSliderDarkThumbBrush}" />
    </Style>
    <Style Selector="vela|VelaElasticSlider.MediaDark /template/ Border#PART_Bubble">
        <Setter Property="Background" Value="{StaticResource PlayerSliderDarkBubbleBgBrush}" />
    </Style>
    <Style Selector="vela|VelaElasticSlider.MediaDark /template/ TextBlock#PART_BubbleText">
        <Setter Property="Foreground" Value="{StaticResource PlayerSliderDarkBubbleFgBrush}" />
    </Style>

    <!-- Compact modifier (Tray panel & tight popovers: suppress floating bubble to avoid window edge clipping) -->
    <Style Selector="vela|VelaElasticSlider.Compact /template/ Border#PART_Bubble">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="vela|VelaElasticSlider.Compact /template/ Border#PART_ThumbVisual">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <!-- =========================================================================
         Vertical Volume Capsule Slider (Vela semantic tokens for vertical flyout)
         ========================================================================= -->
    <Style Selector="Slider.VolumeCapsule">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Background" Value="{DynamicResource VelaControlTrackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource VelaControlFillBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="112" />
        <Setter Property="Template">
            <ControlTemplate>
                <DataValidationErrors>
                    <Grid Background="Transparent" Width="28">
                        <Border Width="8"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                HorizontalAlignment="Center" />

                        <Track Name="PART_Track"
                               Orientation="Vertical"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton"
                                              Background="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Width="8"
                                                    CornerRadius="4"
                                                    Background="{TemplateBinding Background}"
                                                    HorizontalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>

                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton"
                                              Background="Transparent"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>

                            <Track.Thumb>
                                <Thumb Name="thumb"
                                       Width="15" Height="15"
                                       Background="{DynamicResource VelaControlThumbBrush}"
                                       DataContext="{TemplateBinding Value}">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="999"
                                                    BoxShadow="{DynamicResource VelaControlThumbShadow}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Slider.VolumeCapsule /template/ Thumb#thumb">
        <Setter Property="RenderTransform" Value="scale(0.92)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Slider.VolumeCapsule:pointerover /template/ Thumb#thumb">
        <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>
    <Style Selector="Slider.VolumeCapsule:pressed /template/ Thumb#thumb">
        <Setter Property="RenderTransform" Value="scale(1.16)" />
    </Style>

</Styles>
