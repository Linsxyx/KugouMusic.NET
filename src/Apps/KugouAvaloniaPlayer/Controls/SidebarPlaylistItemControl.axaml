<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KugouAvaloniaPlayer.ViewModels"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:behaviors="using:KugouAvaloniaPlayer.Behaviors"
             x:Class="KugouAvaloniaPlayer.Controls.SidebarPlaylistItemControl"
             x:DataType="vm:PlaylistItem"
             x:Name="Root">

    <Border Name="ItemShell"
            Background="Transparent"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ContextRequested="ItemShell_OnContextRequested">
        <Button Command="{Binding #Root.OpenCommand}"
                CommandParameter="{Binding .}"
                Background="Transparent"
                BorderThickness="0"
                Padding="10,6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"
                Cursor="Hand">
            <Button.Template>
                <ControlTemplate>
                    <Border Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Grid ColumnDefinitions="28,*"
                  ColumnSpacing="10"
                  VerticalAlignment="Center">
                <Border Width="28"
                        Height="28"
                        CornerRadius="6"
                        ClipToBounds="True"
                        VerticalAlignment="Center"
                        Background="{DynamicResource VelaSurfaceMutedBrush}">
                    <Image asyncImageLoader:ImageLoader.Source="{Binding Cover}"
                           behaviors:ImageRenderOptions.InterpolationSource="{Binding Cover}"
                           Stretch="UniformToFill" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding Name}"
                           FontSize="13"
                           FontWeight="Medium"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Grid>
        </Button>
    </Border>
</UserControl>
