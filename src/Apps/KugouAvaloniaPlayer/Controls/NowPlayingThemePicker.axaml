<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vela="using:Vela.Avalonia.Controls"
             x:Class="KugouAvaloniaPlayer.Controls.NowPlayingThemePicker"
             ClipToBounds="False">
    <ThemeVariantScope RequestedThemeVariant="Dark">
        <vela:VelaGlassMenu x:Name="ThemeGlassMenu"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            TriggerSize="38"
                            TriggerIcon="{DynamicResource VelaIconSparkles}"
                            MenuWidth="196"
                            MenuCornerRadius="18"
                            BlurRadius="44"
                            TintLevel="Standard" />
    </ThemeVariantScope>
</UserControl>
