<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vela="using:Vela.Avalonia.Controls"
             xmlns:kc="clr-namespace:KugouAvaloniaPlayer.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KugouAvaloniaPlayer.ViewModels"
             xmlns:behaviors="using:KugouAvaloniaPlayer.Behaviors"
             x:Class="KugouAvaloniaPlayer.Controls.PlaybackQueueControl"
             Name="Root"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <Style Selector="vela|VelaListBox.QueueList vela|VelaListBoxItem" x:DataType="vm:SongItem">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="IsSelected" Value="{Binding IsPlaying, Mode=OneWay}" />
        </Style>

        <Style Selector="vela|VelaListBox.QueueList vela|VelaListBoxItem.dragging">
            <Setter Property="Opacity" Value="0.28" />
        </Style>

        <Style Selector="PathIcon.QueueDragHandle">
            <Setter Property="Opacity" Value="0.24" />
            <Setter Property="Foreground" Value="{DynamicResource VelaTextMutedBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="vela|VelaListBox.QueueList vela|VelaListBoxItem:pointerover PathIcon.QueueDragHandle">
            <Setter Property="Opacity" Value="0.78" />
        </Style>

        <Style Selector="Button.QueueAction">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondaryBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="vela|VelaListBox.QueueList:not(.is-dragging) vela|VelaListBoxItem:pointerover Button.QueueAction">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.QueueAction:pointerover">
            <Setter Property="Background" Value="{DynamicResource VelaSurfaceMutedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VelaForegroundBrush}" />
        </Style>
        <Style Selector="Button.QueueAction.Danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource VelaDangerSubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VelaDangerBrush}" />
        </Style>

        <Style Selector="TextBlock.QueueTitle">
            <Setter Property="Foreground" Value="{DynamicResource VelaForegroundBrush}" />
        </Style>
        <Style Selector="TextBlock.QueueTitle.NowPlaying">
            <Setter Property="Foreground" Value="{DynamicResource VelaAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.QueueClearButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.QueueAction /template/ Border#PART_StateLayer,
                         Button.QueueClearButton /template/ Border#PART_StateLayer">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.QueueClearButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource VelaDangerSubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource VelaDangerBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        <!-- 紧凑统计与清空栏 -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*, Auto"
              Margin="16,10,14,6">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <TextBlock Text="当前曲目"
                           FontSize="12"
                           Foreground="{DynamicResource VelaTextMutedBrush}"
                           VerticalAlignment="Center" />
                <vela:VelaBadge Tone="Neutral"
                                IsPill="True"
                                Content="{Binding Player.DisplayPlaybackQueueCount, StringFormat='{}{0} 首'}"
                                VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="QueueClearButton"
                    Command="{Binding Player.ClearQueueCommand}"
                    ToolTip.Tip="清空播放队列"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static kc:KugouIcons.Trash}"
                              Width="13"
                              Height="13"
                              Foreground="{Binding $parent[Button].Foreground}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="清空"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 虚拟化队列列表 + 拖拽重排浮层 -->
        <Panel Grid.Row="1"
               x:Name="QueueListHost"
               ClipToBounds="True">
            <vela:VelaListBox x:Name="QueueListBox"
                              Classes="QueueList"
                              Variant="Plain"
                              ShowSelectionIndicator="True"
                              EmptyContent="播放队列为空"
                              ItemsSource="{Binding Player.DisplayPlaybackQueue}"
                              Padding="10,2,10,16">
                <vela:VelaListBox.ItemTemplate>
                    <DataTemplate DataType="vm:SongItem">
                        <Border x:Name="QueueItemRoot"
                                Padding="8,6,10,6"
                                MinHeight="52"
                                Background="Transparent"
                                ContextRequested="QueueItemRoot_OnContextRequested"
                                behaviors:InteractionBehaviors.DoubleTappedCommand="{Binding #Root.((vm:MainWindowViewModel)DataContext).Player.PlaySongCommand}">
                            <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                                <PathIcon Grid.Column="0"
                                          Classes="QueueDragHandle"
                                          Data="{x:Static kc:KugouIcons.DragHandle}"
                                          Width="13"
                                          Height="13"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding #Root.((vm:MainWindowViewModel)DataContext).Player.CanReorderDisplayPlaybackQueue}" />

                                <Panel Grid.Column="1"
                                       Width="24"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0">
                                    <Border Width="22"
                                            Height="22"
                                            CornerRadius="11"
                                            Background="{DynamicResource VelaAccentSubtleBrush}"
                                            IsVisible="{Binding IsPlaying}">
                                        <PathIcon Data="{x:Static kc:KugouIcons.NavMusic}"
                                                  Width="12"
                                                  Height="12"
                                                  Foreground="{DynamicResource VelaAccentBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <PathIcon Data="{x:Static kc:KugouIcons.NavMusic}"
                                              Width="12"
                                              Height="12"
                                              Opacity="0.35"
                                              Foreground="{DynamicResource VelaTextMutedBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding !IsPlaying}" />
                                </Panel>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Text="{Binding Name}"
                                               Classes="QueueTitle"
                                               Classes.NowPlaying="{Binding IsPlaying}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Singer}"
                                               FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3"
                                            Orientation="Horizontal"
                                            Spacing="2"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                    <Button Classes="QueueAction"
                                            ToolTip.Tip="播放"
                                            Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).Player.PlaySongCommand}"
                                            CommandParameter="{Binding .}">
                                        <PathIcon Data="{x:Static kc:KugouIcons.Play}"
                                                  Width="12"
                                                  Height="12"
                                                  Foreground="{Binding $parent[Button].Foreground}" />
                                    </Button>
                                    <Button Classes="QueueAction Danger"
                                            ToolTip.Tip="移除"
                                            Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).Player.RemoveFromQueueCommand}"
                                            CommandParameter="{Binding .}">
                                        <PathIcon Data="{x:Static kc:KugouIcons.WindowClose}"
                                                  Width="11"
                                                  Height="11"
                                                  Foreground="{Binding $parent[Button].Foreground}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </vela:VelaListBox.ItemTemplate>
            </vela:VelaListBox>

            <Canvas x:Name="DragOverlayCanvas"
                    IsHitTestVisible="False">
                <Grid x:Name="DropIndicator"
                      ColumnDefinitions="Auto, *"
                      Height="6"
                      IsVisible="False">
                    <Ellipse Width="6"
                             Height="6"
                             Fill="{DynamicResource VelaAccentBrush}"
                             VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Height="2"
                            CornerRadius="1"
                            Margin="-1,0,0,0"
                            Background="{DynamicResource VelaAccentBrush}"
                            VerticalAlignment="Center" />
                </Grid>

                <Border x:Name="DragPreviewCard"
                        IsVisible="False"
                        CornerRadius="10"
                        Padding="8,6,10,6"
                        MinHeight="52"
                        Background="{DynamicResource VelaSurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource VelaAccentBrush}"
                        BorderThickness="1"
                        BoxShadow="{DynamicResource VelaShadowFloating}"
                        Opacity="0.95">
                    <Grid ColumnDefinitions="Auto, Auto, *">
                        <PathIcon Grid.Column="0"
                                  Data="{x:Static kc:KugouIcons.DragHandle}"
                                  Width="13"
                                  Height="13"
                                  Margin="0,0,5,0"
                                  Foreground="{DynamicResource VelaAccentBrush}"
                                  VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Width="22"
                                Height="22"
                                CornerRadius="11"
                                Margin="0,0,10,0"
                                Background="{DynamicResource VelaAccentSubtleBrush}"
                                VerticalAlignment="Center">
                            <PathIcon Data="{x:Static kc:KugouIcons.NavMusic}"
                                      Width="12"
                                      Height="12"
                                      Foreground="{DynamicResource VelaAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <TextBlock x:Name="DragPreviewTitle"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource VelaForegroundBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DragPreviewSinger"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource VelaTextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Canvas>
        </Panel>
    </Grid>
</UserControl>
