<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vela="using:Vela.Avalonia.Controls"
             xmlns:kc="clr-namespace:KugouAvaloniaPlayer.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:behaviors="using:KugouAvaloniaPlayer.Behaviors"
             xmlns:local="clr-namespace:KugouAvaloniaPlayer.Controls"
             xmlns:vm="using:KugouAvaloniaPlayer.ViewModels"
             x:Class="KugouAvaloniaPlayer.Controls.BottomPlaybackControl"
             x:DataType="vm:MainWindowViewModel"
             Name="PlaybackControlPanel">

    <UserControl.Styles>
        <Style Selector="vela|VelaLiquidGlass#MiniPlayer">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="vela|VelaLiquidGlass#MiniPlayer.hidden">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector=":is(ComboBox).QualityCombo">
            <Setter Property="MinWidth" Value="96" />
        </Style>
        <Style Selector=":is(ComboBox).QualityCombo ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.QueueDependent.empty">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Button#VolumeButton Popup">
            <Setter Property="ShouldUseOverlayLayer" Value="True" />
            <Setter Property="WindowManagerAddShadowHint" Value="False" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <vela:VelaLiquidGlass Name="MiniPlayer"
                              VerticalAlignment="Bottom"
                              Margin="20,0,20,16"
                              Padding="16,0"
                              CornerRadius="24"
                              BlurRadius="12"
                              BevelWidth="16"
                              Refraction="0.72"
                              Dispersion="0.48"
                              Specular="0.90"
                              Classes.hidden="{Binding NowPlaying.IsOpen}"
                              Height="74">

            <Grid ColumnDefinitions="*, Auto, *">

                <!-- 左侧：封面 + 歌曲信息 -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <Button Command="{Binding NowPlaying.OpenCommand}"
                            Classes="Basic"
                            Padding="0"
                            Cursor="Hand"
                            IsVisible="{Binding Player.HasDisplayPlaybackQueue}"
                            VerticalAlignment="Center">
                        <Grid ColumnDefinitions="Auto, Auto">
                            <Border CornerRadius="10"
                                    ClipToBounds="True"
                                    Width="48"
                                    Height="48">
                                <Image behaviors:LocalArtworkImageBehavior.Source="{Binding Player.DisplayedPlayingSong.Cover}"
                                       behaviors:LocalArtworkImageBehavior.DecodePixelWidth="96"
                                       asyncImageLoader:ImageLoader.Source="{Binding Player.DisplayedPlayingSong.Cover, Converter={StaticResource RemoteImageSourceConverter}}"
                                       behaviors:ImageRenderOptions.InterpolationSource="{Binding Player.DisplayedPlayingSong.Cover}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0"
                                        Spacing="4">
                                <local:ScrollingTextBlock Text="{Binding Player.DisplayedPlayingSong.DisplayTitle, TargetNullValue='KA Music'}"
                                                          IsScrollingEnabled="{Binding Player.IsPlayingAudio}"
                                                          Width="200"
                                                          Height="18"
                                                          FontWeight="Bold"
                                                          FontSize="13"
                                                          Foreground="{DynamicResource SukiText}" />
                                <TextBlock Text="{Binding Player.DisplayedPlayingSong.Singer, TargetNullValue='Ready'}"
                                           FontSize="12"
                                           Opacity="0.55"
                                           Width="200"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SukiLowText}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                </StackPanel>

                <!-- 中间：播放控制 + 进度条 -->
                <Grid Grid.Column="1"
                      RowDefinitions="Auto, Auto"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center">

                    <!-- 播放按钮组 -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,4,0,-4">
                        <Button Cursor="Hand"
                                Command="{Binding Player.ToggleLikeCommand}"
                                Classes="Basic QueueDependent"
                                Classes.empty="{Binding !Player.HasDisplayPlaybackQueue}"
                                Width="32"
                                Height="32"
                                VerticalAlignment="Center">
                            <Panel>
                                <kc:KugouIcon Path="/Assets/FavoriteBorder.svg"
                                     Foreground="Red"
                                     Width="18" Height="18"
                                     IsVisible="{Binding Player.IsLiked}" />
                                <kc:KugouIcon Classes="ThemeSvgIcon"
                                     Path="/Assets/FavoriteBorder.svg"
                                     Width="18" Height="18"
                                     Opacity="0.45"
                                     IsVisible="{Binding !Player.IsLiked}" />
                            </Panel>
                        </Button>
                        <Button Cursor="Hand"
                                Command="{Binding Player.PlayPreviousCommand}"
                                Classes="Basic"
                                Width="32" Height="32">
                            <kc:KugouIcon Classes="ThemeSvgIcon" Path="/Assets/backward.svg" Width="16" Height="16" />
                        </Button>
                        <Button Cursor="Hand"
                                Command="{Binding Player.TogglePlayPauseCommand}"
                                Classes="Basic"
                                Width="40"
                                Height="40">
                            <Panel>
                                <kc:KugouIcon Classes="ThemeSvgIcon"
                                     Path="/Assets/pause-1006-svgrepo-com.svg"
                                     Width="22" Height="22"
                                     IsVisible="{Binding Player.IsPlayingAudio}" />
                                <kc:KugouIcon Classes="ThemeSvgIcon"
                                     Path="/Assets/play-1003-svgrepo-com.svg"
                                     Width="22" Height="22"
                                     IsVisible="{Binding !Player.IsPlayingAudio}" />
                            </Panel>
                        </Button>
                        <Button Cursor="Hand"
                                Command="{Binding Player.PlayNextCommand}"
                                Classes="Basic"
                                Width="32" Height="32">
                            <kc:KugouIcon Classes="ThemeSvgIcon" Path="/Assets/next-svgrepo-com.svg" Width="16" Height="16" />
                        </Button>
                        <Button Cursor="Hand"
                                Command="{Binding Player.CyclePlayModeCommand}"
                                Classes="Basic"
                                Width="32" Height="32"
                                VerticalAlignment="Center">
                            <Panel>
                                <!-- 列表循环 -->
                                <kc:KugouIcon Classes="ThemeSvgIcon"
                                     Path="/Assets/repeat-svgrepo-com.svg"
                                     Width="18" Height="18"
                                     IsVisible="{Binding Player.CurrentPlayMode, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=Normal}" />
                                <!-- 单曲循环 -->
                                <kc:KugouIcon Classes="ThemeSvgIcon"
                                     Path="/Assets/repeat-one.svg"
                                     Width="18" Height="18"
                                     IsVisible="{Binding Player.CurrentPlayMode, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=RepeatOne}" />
                                <!-- 随机播放 -->
                                <kc:KugouIcon Classes="ThemeSvgIcon"
                                     Path="/Assets/shuffle-svgrepo-com.svg"
                                     Width="18" Height="18"
                                     IsVisible="{Binding Player.CurrentPlayMode, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=Shuffle}" />
                            </Panel>
                        </Button>
                    </StackPanel>

                    <!-- 进度条 -->
                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto, *, Auto"
                          Width="390"
                          Margin="0,2,0,2">
                        <TextBlock
                            Text="{Binding Player.CurrentPositionSeconds, Converter={StaticResource SecondsToTimeConverter}}"
                            FontSize="11"
                            FontFeatures="+tnum"
                            Opacity="0.6"
                            Width="44"
                            TextAlignment="Right"
                            VerticalAlignment="Center" />
                        <vela:VelaElasticSlider Grid.Column="1"
                                                Minimum="0"
                                                Maximum="{Binding Player.TotalDurationSeconds}"
                                                Value="{Binding Player.CurrentPositionSeconds, Mode=TwoWay}"
                                                Step="0.1"
                                                Margin="4,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                Classes="MediaProgress" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Player.TotalDurationSeconds, Converter={StaticResource SecondsToTimeConverter}}"
                                   FontSize="11"
                                   FontFeatures="+tnum"
                                   Opacity="0.6"
                                   Width="44"
                                   TextAlignment="Left"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- 右侧：音量 + 工具按钮 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">

                    <!-- 音量控制：悬浮展开竖向滑块，点击按钮静音切换 -->
                    <Button x:Name="VolumeButton"
                            Cursor="Hand"
                            Classes="Basic"
                            Width="32"
                            Height="32"
                            ToolTip.Tip="音量"
                            PointerEntered="VolumeButton_OnPointerEntered"
                            PointerWheelChanged="VolumeButton_OnPointerWheelChanged"
                            Click="VolumeButton_OnClick">
                        <!-- 使用AttachedFlyout以禁用Button的触发影响 -->
                        <FlyoutBase.AttachedFlyout>
                            <Flyout Placement="Top"
                                    VerticalOffset="-8"
                                    ShowMode="TransientWithDismissOnPointerMoveAway"
                                    FlyoutPresenterTheme="{StaticResource TransparentFlyoutPresenterTheme}"
                                    OverlayInputPassThroughElement="{Binding #PlaybackControlPanel}">
                                <vela:VelaLiquidGlass Width="48"
                                                      Height="164"
                                                      CornerRadius="24"
                                                      BlurRadius="14"
                                                      BevelWidth="12"
                                                      Refraction="0.65"
                                                      Dispersion="0.40"
                                                      Specular="0.85"
                                                      Padding="0,12,0,12"
                                                      Margin="6"
                                                      Focusable="False">
                                    <StackPanel Orientation="Vertical"
                                                Spacing="8"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Focusable="False"
                                                   Text="{Binding Player.MusicVolume, StringFormat='{}{0:P0}'}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   FontFeatures="+tnum"
                                                   Foreground="{DynamicResource VelaForegroundBrush}"
                                                   HorizontalAlignment="Center" />
                                        <Slider Minimum="0" Maximum="1"
                                                SmallChange="0.05" LargeChange="0.1"
                                                TickFrequency="0.25"
                                                Value="{Binding Player.MusicVolume}"
                                                Classes="VolumeCapsule"
                                                x:Name="VolumeSlider"
                                                HorizontalAlignment="Center"
                                                PointerWheelChanged="VolumeSlider_OnPointerWheelChanged" />
                                    </StackPanel>
                                </vela:VelaLiquidGlass>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        <Panel>
                            <kc:KugouIcon Classes="ThemeSvgIcon"
                                 Path="/Assets/volume-max-svgrepo-com.svg"
                                 Width="18"
                                 Height="18"
                                 Opacity="0.7"
                                 IsVisible="{Binding !Player.IsMuted}" />
                            <kc:KugouIcon Classes="ThemeSvgIcon"
                                 Path="/Assets/VolumeOff.svg"
                                 Width="18"
                                 Height="18"
                                 Opacity="0.7"
                                 IsVisible="{Binding Player.IsMuted}" />
                        </Panel>
                    </Button>

                    <!--~1~ 分隔感 @1@
                    <Border Width="1" Height="20" Opacity="0.12" Background="Gray" Margin="4,0" />-->

                    <Button Cursor="Hand"
                            Classes="Basic"
                            VerticalAlignment="Center"
                            Padding="8,0"
                            MinWidth="68"
                            Height="32"
                            Click="PlaybackSpeedButton_OnClick">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <kc:KugouIcon Classes="ThemeSvgIcon"
                                 Path="/Assets/speed-svgrepo-com.svg"
                                 Width="16"
                                 Height="16" />
                            <TextBlock Text="{Binding Player.PlaybackSpeedSelection}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    
                    <vela:VelaSelect Size="Small" Classes="QualityCombo"
                              ItemsSource="{Binding Player.QualityOptions}"
                              SelectedItem="{Binding Player.QualitySelection}"
                              IsEnabled="{Binding Player.IsSwitchingQuality, Converter={x:Static BoolConverters.Not}}"
                              VerticalAlignment="Center">
                        <vela:VelaSelect.ItemTemplate>
                            <DataTemplate DataType="x:String">
                                <TextBlock
                                    Text="{Binding ., Converter={StaticResource PlaybackQualityDisplayConverter}}" />

                            </DataTemplate>
                        </vela:VelaSelect.ItemTemplate>
                        <vela:VelaSelect.SelectionBoxItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding ., Converter={StaticResource PlaybackQualityDisplayConverter}}" />
                            </DataTemplate>
                        </vela:VelaSelect.SelectionBoxItemTemplate>
                    </vela:VelaSelect>
                    
                    <!-- 队列按钮：打开 Vela 右侧滑出抽屉 -->
                    <Button x:Name="QueueButton"
                            Cursor="Hand"
                            Classes="Basic"
                            ToolTip.Tip="播放列表"
                            Width="32" Height="32"
                            Click="QueueButton_OnClick">
                        <kc:KugouIcon Classes="ThemeSvgIcon" Path="/Assets/PlayList.svg" Width="18" Height="18" />
                    </Button>

                    <!-- 桌面歌词 -->
                    <Button Cursor="Hand"
                            Command="{Binding ToggleDesktopLyricCommand}"
                            Classes="Basic"
                            ToolTip.Tip="桌面歌词"
                            Width="32" Height="32">
                        <kc:KugouIcon Classes="ThemeSvgIcon"
                             Path="/Assets/DesktopLyric2.svg"
                             Width="20" Height="20"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

            </Grid>
        </vela:VelaLiquidGlass>
    </Grid>
</UserControl>
