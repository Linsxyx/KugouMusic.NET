<Project Sdk="Microsoft.NET.Sdk">
    <!-- Desktop head (Windows / macOS / Linux): entry point, native window options, packaging assets. -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
        <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
        <AssemblyName>KugouAvaloniaPlayer</AssemblyName>
        <PackageId>KugouAvaloniaPlayer</PackageId>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>..\KugouAvaloniaPlayer.Shared\Assets\ka-music.ico</ApplicationIcon>

        <PublishTrimmed>true</PublishTrimmed>
    </PropertyGroup>

    <Import Project="..\KugouAvaloniaPlayer.Common.props" />

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Velopack" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\KugouAvaloniaPlayer.Shared\KugouAvaloniaPlayer.Shared.csproj"/>
        <!-- The UI used to live in the (rooted) entry assembly; keep it untrimmed as before. -->
        <TrimmerRootAssembly Include="KugouAvaloniaPlayer.Shared" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <Content Include="..\KugouAvaloniaPlayer.Shared\Assets\*.ico"
                 Link="Assets\%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Native\KugouTaskbarNative.dll"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest"
                 TargetPath="KugouTaskbarNative.dll"
                 Condition="Exists('Native\KugouTaskbarNative.dll')" />
        <Content Include="Native\KugouTaskbarLyrics.exe"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest"
                 TargetPath="KugouTaskbarLyrics.exe" />
    </ItemGroup>

    <ItemGroup Condition="Exists('Native/kugou-wayland-lyrics') And '$(KugouTargetPlatform)' == 'linux'">
        <Content Include="Native/kugou-wayland-lyrics"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest"
                 TargetPath="kugou-wayland-lyrics"
                 ExcludeFromSingleFile="true" />
        <Content Include="Native/wayland/**/*"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest"
                 Link="wayland/%(RecursiveDir)%(Filename)%(Extension)"
                 ExcludeFromSingleFile="true" />
    </ItemGroup>
</Project>
