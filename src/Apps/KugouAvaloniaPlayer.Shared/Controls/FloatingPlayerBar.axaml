<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:KugouAvaloniaPlayer.Controls"
             xmlns:vm="using:KugouAvaloniaPlayer.ViewModels"
             x:Class="KugouAvaloniaPlayer.Controls.FloatingPlayerBar"
             x:DataType="vm:NowPlayingViewModel"
             Background="Transparent">

    <UserControl.Styles>
        <!-- 基础容器样式与尺寸过渡动画 -->
        <Style Selector="Border#BarBorder">
            <Setter Property="Background" Value="#E5121928" />
            <Setter Property="BorderBrush" Value="#28FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="BoxShadow" Value="0 18 50 0 #66000000" />
            <Setter Property="Width" Value="390" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.28" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Height" Duration="0:0:0.28" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <!-- 悬浮或展开状态的容器尺寸与圆角 -->
        <Style Selector="controls|FloatingPlayerBar:expanded Border#BarBorder">
            <Setter Property="Width" Value="540" />
            <Setter Property="Height" Value="82" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="CornerRadius" Value="24" />
        </Style>

        <!-- 上层播放控制区域：收起时高度为0且隐藏，展开时淡入并滑入 -->
        <Style Selector="Grid#ExpandedControls">
            <Setter Property="Height" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransform" Value="translateY(6px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Height" Duration="0:0:0.25" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="controls|FloatingPlayerBar:expanded Grid#ExpandedControls">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="RenderTransform" Value="translateY(0)" />
        </Style>

        <!-- 默认文本与图标样式（高对比度保底） -->
        <Style Selector="TextBlock.BarTime">
            <Setter Property="Foreground" Value="#C8E8ECF3" />
        </Style>
        <Style Selector="TextBlock.BarTitle">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="TextBlock.BarSinger">
            <Setter Property="Foreground" Value="#B8E8ECF3" />
        </Style>
        <Style Selector="Svg.BarIcon">
            <Setter Property="Css" Value="* { color: #E8ECF3; fill: #E8ECF3; stroke: #E8ECF3; }" />
        </Style>

        <!-- 按钮通用样式 -->
        <Style Selector="Button.BarBtn">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.BarBtn:pointerover">
            <Setter Property="Background" Value="#18FFFFFF" />
        </Style>

        <Style Selector="Button.BarPlayBtn">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#25FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.BarPlayBtn:pointerover">
            <Setter Property="Background" Value="#38FFFFFF" />
        </Style>

        <!-- Fume 主题色彩适配 (金黄琥珀色) -->
        <Style Selector="controls|FloatingPlayerBar.Fume Border#BarBorder">
            <Setter Property="Background" Value="#E5121928" />
            <Setter Property="BorderBrush" Value="#28F2EBDD" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Fume TextBlock.BarTime">
            <Setter Property="Foreground" Value="#C8D6A91F" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Fume TextBlock.BarTitle">
            <Setter Property="Foreground" Value="#F2EBDD" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Fume TextBlock.BarSinger">
            <Setter Property="Foreground" Value="#B8D6A91F" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Fume Button.BarPlayBtn">
            <Setter Property="Background" Value="#25D6A91F" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Fume Button.BarPlayBtn:pointerover">
            <Setter Property="Background" Value="#38D6A91F" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Fume Svg.BarIcon">
            <Setter Property="Css" Value="* { color: #D6A91F; fill: #D6A91F; stroke: #D6A91F; }" />
        </Style>

        <!-- Tempera 主题色彩适配 (午夜墨染) -->
        <Style Selector="controls|FloatingPlayerBar.Tempera Border#BarBorder">
            <Setter Property="Background" Value="#E509090B" />
            <Setter Property="BorderBrush" Value="#33F4F4F5" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Tempera TextBlock.BarTime">
            <Setter Property="Foreground" Value="#C8F4F4F5" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Tempera TextBlock.BarTitle">
            <Setter Property="Foreground" Value="#F4F4F5" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Tempera TextBlock.BarSinger">
            <Setter Property="Foreground" Value="#A1A1AA" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Tempera Button.BarPlayBtn">
            <Setter Property="Background" Value="#25F4F4F5" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Tempera Button.BarPlayBtn:pointerover">
            <Setter Property="Background" Value="#38F4F4F5" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Tempera Svg.BarIcon">
            <Setter Property="Css" Value="* { color: #F4F4F5; fill: #F4F4F5; stroke: #F4F4F5; }" />
        </Style>

        <!-- Lumiere 主题色彩适配 (银月蓝白色) -->
        <Style Selector="controls|FloatingPlayerBar.Lumiere Border#BarBorder">
            <Setter Property="Background" Value="#E5121928" />
            <Setter Property="BorderBrush" Value="#28FFFFFF" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Lumiere TextBlock.BarTime">
            <Setter Property="Foreground" Value="#C8E8ECF3" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Lumiere TextBlock.BarTitle">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Lumiere TextBlock.BarSinger">
            <Setter Property="Foreground" Value="#B8E8ECF3" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Lumiere Button.BarPlayBtn">
            <Setter Property="Background" Value="#25FFFFFF" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Lumiere Button.BarPlayBtn:pointerover">
            <Setter Property="Background" Value="#38FFFFFF" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Lumiere Svg.BarIcon">
            <Setter Property="Css" Value="* { color: #E8ECF3; fill: #E8ECF3; stroke: #E8ECF3; }" />
        </Style>

        <!-- Sonnet 主题色彩适配 (纯净白色) -->
        <Style Selector="controls|FloatingPlayerBar.Sonnet Border#BarBorder">
            <Setter Property="Background" Value="#E5121928" />
            <Setter Property="BorderBrush" Value="#28FFFFFF" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Sonnet TextBlock.BarTime">
            <Setter Property="Foreground" Value="#C8E8ECF3" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Sonnet TextBlock.BarTitle">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Sonnet TextBlock.BarSinger">
            <Setter Property="Foreground" Value="#B8E8ECF3" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Sonnet Button.BarPlayBtn">
            <Setter Property="Background" Value="#25FFFFFF" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Sonnet Button.BarPlayBtn:pointerover">
            <Setter Property="Background" Value="#38FFFFFF" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Sonnet Svg.BarIcon">
            <Setter Property="Css" Value="* { color: #E8ECF3; fill: #E8ECF3; stroke: #E8ECF3; }" />
        </Style>

        <!-- Pendolo 主题色彩适配 (湖蓝青色) -->
        <Style Selector="controls|FloatingPlayerBar.Pendolo Border#BarBorder">
            <Setter Property="Background" Value="#E50A1420" />
            <Setter Property="BorderBrush" Value="#355FA8C9" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Pendolo TextBlock.BarTime">
            <Setter Property="Foreground" Value="#C067B9DB" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Pendolo TextBlock.BarTitle">
            <Setter Property="Foreground" Value="#FFE6F5FF" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Pendolo TextBlock.BarSinger">
            <Setter Property="Foreground" Value="#8FE6F5FF" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Pendolo Button.BarPlayBtn">
            <Setter Property="Background" Value="#2867B9DB" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Pendolo Button.BarPlayBtn:pointerover">
            <Setter Property="Background" Value="#4067B9DB" />
        </Style>
        <Style Selector="controls|FloatingPlayerBar.Pendolo Svg.BarIcon">
            <Setter Property="Css" Value="* { color: #67B9DB; fill: #67B9DB; stroke: #67B9DB; }" />
        </Style>
    </UserControl.Styles>

    <Border x:Name="BarBorder">
        <Grid RowDefinitions="Auto, *">
            <!-- 展开状态下的上层控制区域：歌曲名、播放控制、循环/喜欢 -->
            <Grid x:Name="ExpandedControls"
                  Grid.Row="0"
                  ColumnDefinitions="*, Auto, *"
                  VerticalAlignment="Center">
                <!-- 左侧：曲名与歌手 -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="4,0,8,0"
                            Spacing="1">
                    <TextBlock Text="{Binding Player.DisplayedPlayingSong.DisplayTitle, FallbackValue=''}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Classes="BarTitle" />
                    <TextBlock Text="{Binding Player.DisplayedPlayingSong.Singer, FallbackValue=''}"
                               FontSize="10"
                               Opacity="0.75"
                               TextTrimming="CharacterEllipsis"
                               Classes="BarSinger" />
                </StackPanel>

                <!-- 中间：上一首、播放/暂停、下一首 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Command="{Binding Player.PlayPreviousCommand}"
                            Classes="Basic BarBtn"
                            ToolTip.Tip="上一首">
                        <Svg Classes="BarIcon" Path="/Assets/backward.svg" Width="13" Height="13" />
                    </Button>

                    <Button Command="{Binding Player.TogglePlayPauseCommand}"
                            Classes="Basic BarPlayBtn"
                            ToolTip.Tip="播放 / 暂停">
                        <Panel>
                            <Svg Classes="BarIcon" Path="/Assets/pause-1006-svgrepo-com.svg" Width="15" Height="15"
                                 IsVisible="{Binding Player.IsPlayingAudio}" />
                            <Svg Classes="BarIcon" Path="/Assets/play-1003-svgrepo-com.svg" Width="15" Height="15"
                                 Margin="2,0,0,0"
                                 IsVisible="{Binding !Player.IsPlayingAudio}" />
                        </Panel>
                    </Button>

                    <Button Command="{Binding Player.PlayNextCommand}"
                            Classes="Basic BarBtn"
                            ToolTip.Tip="下一首">
                        <Svg Classes="BarIcon" Path="/Assets/next-svgrepo-com.svg" Width="13" Height="13" />
                    </Button>
                </StackPanel>

                <!-- 右侧：播放模式、喜欢 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Command="{Binding Player.CyclePlayModeCommand}"
                            Classes="Basic BarBtn"
                            ToolTip.Tip="播放模式">
                        <Panel>
                            <Svg Classes="BarIcon" Path="/Assets/repeat-svgrepo-com.svg" Width="13" Height="13"
                                 IsVisible="{Binding Player.CurrentPlayMode, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=Normal}" />
                            <Svg Classes="BarIcon" Path="/Assets/repeat-one.svg" Width="13" Height="13"
                                 IsVisible="{Binding Player.CurrentPlayMode, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=RepeatOne}" />
                            <Svg Classes="BarIcon" Path="/Assets/shuffle-svgrepo-com.svg" Width="13" Height="13"
                                 IsVisible="{Binding Player.CurrentPlayMode, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=Shuffle}" />
                        </Panel>
                    </Button>

                    <Button Command="{Binding Player.ToggleLikeCommand}"
                            Classes="Basic BarBtn"
                            ToolTip.Tip="喜欢">
                        <Panel>
                            <Svg Path="/Assets/FavoriteBorder.svg" Css="path { fill: #FF4757; }" Width="13" Height="13"
                                 IsVisible="{Binding Player.IsLiked}" />
                            <Svg Classes="BarIcon" Path="/Assets/FavoriteBorder.svg" Width="13" Height="13" Opacity="0.55"
                                 IsVisible="{Binding !Player.IsLiked}" />
                        </Panel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 下层：进度条与时间显示（始终居中显示） -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto, *, Auto"
                  ColumnSpacing="10"
                  VerticalAlignment="Center">
                <TextBlock Text="{Binding Player.CurrentPositionSeconds, Converter={StaticResource SecondsToTimeConverter}}"
                           FontSize="11"
                           FontFamily="Monospace"
                           Classes="BarTime"
                           VerticalAlignment="Center" />
                <Slider x:Name="ProgressSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="{Binding Player.TotalDurationSeconds}"
                        Value="{Binding Player.CurrentPositionSeconds}"
                        IsSnapToTickEnabled="False"
                        Classes="Player PlayerDark PlayerCompact"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Player.TotalDurationSeconds, Converter={StaticResource SecondsToTimeConverter}}"
                           FontSize="11"
                           FontFamily="Monospace"
                           Classes="BarTime"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
