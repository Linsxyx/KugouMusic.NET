<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:KugouAvaloniaPlayer.ViewModels" xmlns:localControls="using:KugouAvaloniaPlayer.Controls" xmlns:models="clr-namespace:KugouAvaloniaPlayer.Models" x:Class="KugouAvaloniaPlayer.Views.Settings.GeneralSection" x:Name="UserRoot" x:DataType="vm:SettingViewModel">
    <StackPanel>
        <TextBlock Classes="GroupHeader" Text="窗口" />
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="关闭窗口时" />
                    <TextBlock Classes="RowHint" Text="点击窗口关闭按钮后的行为。" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableCloseBehaviors}" SelectedItem="{Binding SelectedCloseBehavior}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="models:CloseBehavior">
                            <TextBlock Text="{Binding Converter={StaticResource CloseBehaviorConverter}}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto" IsVisible="{Binding IsLinuxWindowDecorationToggleVisible}">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="系统标题栏" />
                    <TextBlock Classes="RowHint" Text="改善 Linux 下的窗口拖动与缩放兼容性。" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding LinuxUseFullWindowDecorations, Mode=TwoWay}" />
            </localControls:SettingsRow>
        </localControls:SettingsCard>

        <TextBlock Classes="GroupHeader" Text="诊断" />
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="日志文件夹" />
                    <TextBlock Classes="RowHint" Text="反馈问题时可附上日志文件。" />
                </StackPanel>
                <Button Grid.Column="1" Classes="Basic" Command="{Binding OpenLogFolderCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Svg Classes="ThemeSvgIcon" Path="/Assets/open-log-folder.svg" Width="16" Height="16" />
                        <TextBlock Text="打开文件夹" />
                    </StackPanel>
                </Button>
            </localControls:SettingsRow>
        </localControls:SettingsCard>

        <TextBlock Classes="GroupHeader" Text="重置" />
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="恢复默认设置" Foreground="{DynamicResource SukiDangerColor}" />
                    <TextBlock Classes="RowHint" Text="保留本地音乐记录和服务器配置。" />
                </StackPanel>
                <Button Grid.Column="1" Classes="Basic" Command="{Binding ResetAllSettingsCommand}" MinWidth="88">
                    <TextBlock Text="重置" Foreground="{DynamicResource SukiDangerColor}" />
                </Button>
            </localControls:SettingsRow>
        </localControls:SettingsCard>
    </StackPanel>
</UserControl>
