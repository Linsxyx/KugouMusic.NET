<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:KugouAvaloniaPlayer.ViewModels" xmlns:suki="https://github.com/kikipoulet/SukiUI" xmlns:localControls="using:KugouAvaloniaPlayer.Controls" xmlns:simpleAudio="clr-namespace:SimpleAudio;assembly=SimpleAudio" x:Class="KugouAvaloniaPlayer.Views.Settings.PlaybackSection" x:Name="UserRoot" x:DataType="vm:SettingViewModel">
    <StackPanel>
        <TextBlock Classes="GroupHeader" Text="输出" />
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto" IsVisible="{Binding IsOutputDeviceSelectionVisible}">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="输出设备" />
                    <TextBlock Classes="RowHint" Text="{Binding OutputDeviceStatus}" IsVisible="{Binding IsOutputDeviceStatusVisible}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox MinWidth="200" ItemsSource="{Binding OutputDeviceOptions}" SelectedItem="{Binding SelectedOutputDevice}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="simpleAudio:AudioOutputDevice">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.SelectionBoxItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.SelectionBoxItemTemplate>
                    </ComboBox>
                    <Button Classes="Basic" Cursor="Hand" Command="{Binding RefreshOutputDevicesCommand}" ToolTip.Tip="刷新输出设备列表">
                        <PathIcon Data="{x:Static suki:Icons.Refresh}" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="播放音质" />
                    <TextBlock Classes="RowHint" Text="可用音质取决于音源。" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Player.QualityOptions}" SelectedItem="{Binding Player.QualitySelection}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="x:String">
                            <TextBlock Text="{Binding ., Converter={StaticResource PlaybackQualityDisplayConverter}}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.SelectionBoxItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ., Converter={StaticResource PlaybackQualityDisplayConverter}}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ComboBox.SelectionBoxItemTemplate>
                </ComboBox>
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="智能过渡" />
                    <TextBlock Classes="RowHint" Text="在歌曲尾段平滑切换到下一首。" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableSeamlessTransition, Mode=TwoWay}" />
            </localControls:SettingsRow>
        </localControls:SettingsCard>

        <TextBlock Classes="GroupHeader" Text="音效" />
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="均衡器" />
                    <TextBlock Classes="RowHint" Text="选择预设，或手动绘制频响曲线。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{Binding EQPresetOptions}" SelectedItem="{Binding SelectedEQPreset}" />
                    <Button Classes="Basic" Content="调整曲线" Command="{Binding OpenEqSettingsCommand}" />
                </StackPanel>
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="音量平衡" />
                    <TextBlock Classes="RowHint" Text="减小歌曲之间的音量差异。" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableVolumeNormalization, Mode=TwoWay}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="空间音效" />
                    <TextBlock Classes="RowHint" Text="增强声音的空间感。" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableSurround, Mode=TwoWay}" />
            </localControls:SettingsRow>
        </localControls:SettingsCard>
    </StackPanel>
</UserControl>
