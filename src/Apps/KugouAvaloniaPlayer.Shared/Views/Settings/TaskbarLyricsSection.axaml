<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:KugouAvaloniaPlayer.ViewModels" xmlns:localControls="using:KugouAvaloniaPlayer.Controls" x:Class="KugouAvaloniaPlayer.Views.Settings.TaskbarLyricsSection" x:Name="UserRoot" x:DataType="vm:SettingViewModel">
    <StackPanel>
        <TextBlock Classes="GroupHeader" Text="常规" />
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="显示任务栏歌词" />
                    <TextBlock Classes="RowHint" Text="在任务栏空白处显示当前歌词。" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableTaskbarLyrics, Mode=TwoWay}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto" IsEnabled="{Binding EnableTaskbarLyrics}">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="显示翻译" />
                    <TextBlock Classes="RowHint" Text="关闭后放大主歌词。" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding TaskbarLyricsShowTranslation, Mode=TwoWay}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto" IsEnabled="{Binding EnableTaskbarLyrics}">
                <TextBlock Classes="RowTitle" Text="对齐方式" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding TaskbarLyricAlignmentOptions}" SelectedItem="{Binding TaskbarSelectedLyricAlignment}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto" IsEnabled="{Binding EnableTaskbarLyrics}">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="水平微调" />
                    <TextBlock Classes="RowHint" Text="负值左移，正值右移；方向键每次调整 1 像素。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="RowSlider">
                    <Slider Minimum="-200" Maximum="200" TickFrequency="1" SmallChange="1" LargeChange="20" IsSnapToTickEnabled="True" Value="{Binding TaskbarLyricsHorizontalOffset, Mode=TwoWay}" />
                    <TextBlock Classes="RowValue" Text="{Binding TaskbarLyricsHorizontalOffset, StringFormat={}{0} px}" />
                </StackPanel>
            </localControls:SettingsRow>
        </localControls:SettingsCard>

        <TextBlock Classes="GroupHeader" Text="文字" />
        <localControls:SettingsCard IsEnabled="{Binding EnableTaskbarLyrics}">
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <TextBlock Classes="RowTitle" Text="字体" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding LyricFontFamilyOptions}" SelectedItem="{Binding TaskbarSelectedLyricFontFamily}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="x:String">
                            <TextBlock Text="{Binding .}" FontFamily="{Binding .}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="字号" />
                    <TextBlock Classes="RowHint" Text="隐藏翻译时自动放大。" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding TaskbarLyricFontSizeOptions}" SelectedItem="{Binding TaskbarLyricsFontSize}" />
            </localControls:SettingsRow>
        </localControls:SettingsCard>

        <Grid Classes="GroupHeader" ColumnDefinitions="*,Auto">
            <TextBlock Classes="GroupHeader" Text="颜色" />
            <Button Grid.Column="1" Classes="Basic" Content="恢复默认" Command="{Binding ResetTaskbarLyricsAppearanceCommand}" IsEnabled="{Binding EnableTaskbarLyrics}" />
        </Grid>
        <localControls:SettingsCard IsEnabled="{Binding EnableTaskbarLyrics}">
            <localControls:SettingsRow ColumnDefinitions="*,Auto,140,Auto" ColumnSpacing="10">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="未播放颜色" />
                    <TextBlock Classes="RowHint" Text="同时用于翻译。" />
                    <TextBlock Classes="RowHint" Text="{Binding TaskbarUnplayedColorError}" IsVisible="{Binding HasTaskbarUnplayedColorError}" Foreground="{DynamicResource SukiDangerColor}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="Swatch" CornerRadius="6" Background="{Binding TaskbarUnplayedColorPreviewBrush}" />
                <TextBox Grid.Column="2" PlaceholderText="#FF2E2E2E" Text="{Binding TaskbarUnplayedColorHexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="3" Classes="Basic" MinWidth="64" Content="应用" Command="{Binding ApplyTaskbarUnplayedColorHexCommand}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto,140,Auto" ColumnSpacing="10">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="已播放颜色" />
                    <TextBlock Classes="RowHint" Text="{Binding TaskbarPlayedColorError}" IsVisible="{Binding HasTaskbarPlayedColorError}" Foreground="{DynamicResource SukiDangerColor}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="Swatch" CornerRadius="6" Background="{Binding TaskbarPlayedColorPreviewBrush}" />
                <TextBox Grid.Column="2" PlaceholderText="#FF268EEB" Text="{Binding TaskbarPlayedColorHexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="3" Classes="Basic" MinWidth="64" Content="应用" Command="{Binding ApplyTaskbarPlayedColorHexCommand}" />
            </localControls:SettingsRow>
        </localControls:SettingsCard>
    </StackPanel>
</UserControl>
