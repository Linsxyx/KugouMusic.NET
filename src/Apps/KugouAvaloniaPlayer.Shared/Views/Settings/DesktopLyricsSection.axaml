<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:KugouAvaloniaPlayer.ViewModels" xmlns:localControls="using:KugouAvaloniaPlayer.Controls" x:Class="KugouAvaloniaPlayer.Views.Settings.DesktopLyricsSection" x:Name="UserRoot" x:DataType="vm:SettingViewModel">
    <StackPanel>
        <TextBlock Classes="GroupHeader" Text="窗口" />
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto" IsVisible="{Binding IsNativeDesktopLyricOptionsVisible}">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="使用原生桌面歌词" />
                    <TextBlock Classes="RowHint" Text="适用于支持的 Wayland 桌面；不支持时自动使用默认窗口。" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableNativeDesktopLyrics, Mode=TwoWay}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto" IsVisible="{Binding IsWaylandDesktopLyricOptionsVisible}">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="全屏应用上显示歌词" />
                    <TextBlock Classes="RowHint" Text="使用原生 Wayland 桌面歌词时生效。" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding WaylandDesktopLyricOverFullscreen, Mode=TwoWay}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="桌面歌词锁定" />
                    <TextBlock Classes="RowHint" Text="锁定后歌词窗口不响应鼠标，可在此解除。" />
                </StackPanel>
                <Button Grid.Column="1" Classes="Basic" Cursor="Hand" Content="解除锁定" Command="{Binding UnlockDesktopLyricCommand}" />
            </localControls:SettingsRow>
        </localControls:SettingsCard>

        <TextBlock Classes="GroupHeader" Text="排版" />
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <TextBlock Classes="RowTitle" Text="排版方向" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding DesktopLyricLayoutOptions}" SelectedItem="{Binding DesktopSelectedLyricLayout}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <TextBlock Classes="RowTitle" Text="对齐方式" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding LyricAlignmentOptions}" SelectedItem="{Binding DesktopSelectedLyricAlignment}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="双行歌词" />
                    <TextBlock Classes="RowHint" Text="歌词上下交替显示，开启后隐藏翻译。" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DesktopLyricDoubleLineEnabled, Mode=TwoWay}" />
            </localControls:SettingsRow>
        </localControls:SettingsCard>

        <TextBlock Classes="GroupHeader" Text="字体" />
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="字体模式" />
                    <TextBlock Classes="RowHint" Text="歌词与翻译共用字体。" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding LyricFontModeOptions}" SelectedItem="{Binding DesktopSelectedLyricFontMode}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto" IsVisible="{Binding IsDesktopLyricFontCustomMode}">
                <TextBlock Classes="RowTitle" Text="字体" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding LyricFontFamilyOptions}" SelectedItem="{Binding DesktopSelectedLyricFontFamily}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="x:String">
                            <TextBlock Text="{Binding .}" FontFamily="{Binding .}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </localControls:SettingsRow>
        </localControls:SettingsCard>

        <TextBlock Classes="GroupHeader" Text="颜色" />
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="调整对象" />
                    <TextBlock Classes="RowHint" Text="选择要修改颜色的歌词部分。" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding LyricColorTargetOptions}" SelectedItem="{Binding DesktopSelectedLyricColorTarget}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <TextBlock Classes="RowTitle" Text="颜色模式" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding LyricColorModeOptions}" SelectedItem="{Binding DesktopSelectedLyricColorMode}" />
            </localControls:SettingsRow>
            <StackPanel Classes="RowDetail" IsVisible="{Binding IsDesktopLyricColorCustomMode}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Classes="Swatch" Background="{Binding DesktopLyricColorPreviewBrush}" />
                    <TextBox Grid.Column="1" PlaceholderText="#FFFFFFFF" Text="{Binding DesktopLyricColorHexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Classes="Basic" Command="{Binding ApplyDesktopLyricColorHexCommand}" Content="应用" MinWidth="72" />
                </Grid>
                <ItemsControl ItemsSource="{Binding LyricColorPalette}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="x:String">
                            <Button Classes="PaletteSwatch" Background="{Binding .}" ToolTip.Tip="{Binding .}" Command="{Binding #UserRoot.((vm:SettingViewModel)DataContext).PickDesktopLyricPaletteColorCommand}" CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding DesktopColorError}" IsVisible="{Binding HasDesktopColorError}" Foreground="{DynamicResource SukiDangerColor}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </localControls:SettingsCard>
    </StackPanel>
</UserControl>
