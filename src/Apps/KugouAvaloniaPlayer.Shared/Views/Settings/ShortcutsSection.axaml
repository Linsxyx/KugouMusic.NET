<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:KugouAvaloniaPlayer.ViewModels" xmlns:localControls="using:KugouAvaloniaPlayer.Controls" xmlns:behaviors="using:KugouAvaloniaPlayer.Behaviors" x:Class="KugouAvaloniaPlayer.Views.Settings.ShortcutsSection" x:Name="UserRoot" x:DataType="vm:SettingViewModel">
    <StackPanel>
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="启用全局快捷键" />
                    <TextBlock Classes="RowHint" Text="窗口隐藏后仍可使用。" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableGlobalShortcuts, Mode=TwoWay}" />
            </localControls:SettingsRow>
        </localControls:SettingsCard>

        <Grid Classes="GroupHeader" ColumnDefinitions="*,Auto">
            <TextBlock Classes="GroupHeader" Text="按键绑定 · 点击按键可重新录制" TextWrapping="Wrap" />
            <Button Grid.Column="1" Classes="Basic" Content="取消录制" Command="{Binding CancelShortcutRecordingCommand}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding ShortcutItems}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><localControls:SettingsCard /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:GlobalShortcutItemViewModel">
                    <localControls:SettingsRow ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <StackPanel>
                            <TextBlock Classes="RowTitle" Text="{Binding DisplayName}" />
                            <TextBlock Classes="RowHint" Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" Foreground="{Binding StatusForeground}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="Keycap" Command="{Binding #UserRoot.((vm:SettingViewModel)DataContext).BeginShortcutRecordingCommand}" CommandParameter="{Binding .}" behaviors:InteractionBehaviors.KeyDownCommand="{Binding #UserRoot.((vm:SettingViewModel)DataContext).CaptureShortcutKeyCommand}" behaviors:InteractionBehaviors.KeyDownCommandParameter="{Binding .}" LostFocus="OnRecordingLostFocus">
                            <TextBlock Text="{Binding ShortcutText}" TextWrapping="Wrap" />
                        </Button>
                        <Button Grid.Column="2" Classes="Basic" ToolTip.Tip="清空" Command="{Binding #UserRoot.((vm:SettingViewModel)DataContext).ClearShortcutCommand}" CommandParameter="{Binding .}">
                            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Width="12" Height="12" />
                        </Button>
                    </localControls:SettingsRow>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
