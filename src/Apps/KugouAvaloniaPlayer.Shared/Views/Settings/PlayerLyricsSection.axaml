<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:KugouAvaloniaPlayer.ViewModels" xmlns:localControls="using:KugouAvaloniaPlayer.Controls" x:Class="KugouAvaloniaPlayer.Views.Settings.PlayerLyricsSection" x:Name="UserRoot" x:DataType="vm:SettingViewModel">
    <StackPanel>
        <TextBlock Classes="GroupHeader" Text="显示" />
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="显示频谱" />
                    <TextBlock Classes="RowHint" Text="显示在播放页进度条下方。" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableNowPlayingVisualizer, Mode=TwoWay}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="关闭上升动效" />
                    <TextBlock Classes="RowHint" Text="歌词切换时直接滚动，降低性能占用。" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseLightweightNowPlayingLyricScroll, Mode=TwoWay}" />
            </localControls:SettingsRow>
        </localControls:SettingsCard>

        <TextBlock Classes="GroupHeader" Text="文字" />
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <TextBlock Classes="RowTitle" Text="字号" />
                <StackPanel Grid.Column="1" Classes="RowSlider">
                    <Slider Minimum="18" Maximum="42" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PlayPageLyricFontSize, Mode=TwoWay}" />
                    <TextBlock Classes="RowValue" Text="{Binding PlayPageLyricFontSizeDisplay}" />
                </StackPanel>
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <TextBlock Classes="RowTitle" Text="对齐方式" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding LyricAlignmentOptions}" SelectedItem="{Binding PlayPageSelectedLyricAlignment}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="字体模式" />
                    <TextBlock Classes="RowHint" Text="歌词与翻译共用字体。" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding LyricFontModeOptions}" SelectedItem="{Binding PlayPageSelectedLyricFontMode}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto" IsVisible="{Binding IsPlayPageLyricFontCustomMode}">
                <TextBlock Classes="RowTitle" Text="字体" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding LyricFontFamilyOptions}" SelectedItem="{Binding PlayPageSelectedLyricFontFamily}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="x:String">
                            <TextBlock Text="{Binding .}" FontFamily="{Binding .}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </localControls:SettingsRow>
        </localControls:SettingsCard>

        <TextBlock Classes="GroupHeader" Text="颜色" />
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="调整对象" />
                    <TextBlock Classes="RowHint" Text="选择要修改颜色的歌词部分。" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding LyricColorTargetOptions}" SelectedItem="{Binding PlayPageSelectedLyricColorTarget}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <TextBlock Classes="RowTitle" Text="颜色模式" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding LyricColorModeOptions}" SelectedItem="{Binding PlayPageSelectedLyricColorMode}" />
            </localControls:SettingsRow>
            <StackPanel Classes="RowDetail" IsVisible="{Binding IsPlayPageLyricColorCustomMode}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Classes="Swatch" Background="{Binding PlayPageLyricColorPreviewBrush}" />
                    <TextBox Grid.Column="1" PlaceholderText="#FFFFFFFF" Text="{Binding PlayPageLyricColorHexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Classes="Basic" Command="{Binding ApplyPlayPageLyricColorHexCommand}" Content="应用" MinWidth="72" />
                </Grid>
                <ItemsControl ItemsSource="{Binding LyricColorPalette}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="x:String">
                            <Button Classes="PaletteSwatch" Background="{Binding .}" ToolTip.Tip="{Binding .}" Command="{Binding #UserRoot.((vm:SettingViewModel)DataContext).PickPlayPageLyricPaletteColorCommand}" CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding PlayPageColorError}" IsVisible="{Binding HasPlayPageColorError}" Foreground="{DynamicResource SukiDangerColor}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </localControls:SettingsCard>
    </StackPanel>
</UserControl>
