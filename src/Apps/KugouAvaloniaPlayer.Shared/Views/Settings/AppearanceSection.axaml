<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:KugouAvaloniaPlayer.ViewModels" xmlns:localControls="using:KugouAvaloniaPlayer.Controls" xmlns:models="clr-namespace:KugouAvaloniaPlayer.Models" xmlns:services="using:KugouAvaloniaPlayer.Services" x:Class="KugouAvaloniaPlayer.Views.Settings.AppearanceSection" x:Name="UserRoot" x:DataType="vm:SettingViewModel">
    <StackPanel>
        <TextBlock Classes="GroupHeader" Text="主题与字体" />
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="界面缩放" />
                    <TextBlock Classes="RowHint" Text="放大文字和控件（包括播放页）。自动会在大屏或高分辨率下按屏幕尺寸放大。" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding UiScaleOptions}" SelectedItem="{Binding SelectedUiScaleOption}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="services:UiScaleOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="深色模式" />
                    <TextBlock Classes="RowHint" Text="切换应用的明暗配色。" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" Classes="Gorgeous" IsChecked="{Binding IsDarkMode, Mode=TwoWay}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="界面字体" />
                    <TextBlock Classes="RowHint" Text="未自定义字体的歌词也会使用此字体。" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AppFontFamilyOptions}" SelectedItem="{Binding SelectedAppFontFamily}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="x:String">
                            <TextBlock Text="{Binding .}" FontFamily="{Binding .}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </localControls:SettingsRow>
        </localControls:SettingsCard>

        <TextBlock Classes="GroupHeader" Text="自定义背景" />
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="使用自定义背景" />
                    <TextBlock Classes="RowHint" Text="用一张图片作为主界面背景。" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCustomBackgroundImage, Mode=TwoWay}" />
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="背景图片" />
                    <TextBlock Classes="RowHint" Text="{Binding CustomBackgroundImageStatus}" ToolTip.Tip="{Binding CustomBackgroundImagePath}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="Basic" Content="选择图片" Command="{Binding PickCustomBackgroundImageCommand}" />
                    <Button Classes="Basic" Content="清除" Command="{Binding ClearCustomBackgroundImageCommand}" />
                </StackPanel>
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto" IsEnabled="{Binding UseCustomBackgroundImage}">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="图片透明度" />
                    <TextBlock Classes="RowHint" Text="开启自定义背景后可调节。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="RowSlider">
                    <Slider Minimum="0.1" Maximum="1" TickFrequency="0.05" Value="{Binding CustomBackgroundImageOpacity, Mode=TwoWay}" />
                    <TextBlock Classes="RowValue" Text="{Binding CustomBackgroundImageOpacityDisplay}" />
                </StackPanel>
            </localControls:SettingsRow>
        </localControls:SettingsCard>

        <TextBlock Classes="GroupHeader" Text="播放页" />
        <localControls:SettingsCard>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="播放页背景" />
                    <TextBlock Classes="RowHint" Text="打开播放页时显示的背景来源。" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding NowPlayingBackgroundSourceOptions}" SelectedItem="{Binding SelectedNowPlayingBackgroundSource}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="models:NowPlayingBackgroundSource">
                            <TextBlock Text="{Binding Converter={StaticResource NowPlayingBackgroundSourceConverter}}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.SelectionBoxItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource NowPlayingBackgroundSourceConverter}}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ComboBox.SelectionBoxItemTemplate>
                </ComboBox>
            </localControls:SettingsRow>
            <localControls:SettingsRow ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="RowTitle" Text="背景模糊" />
                    <TextBlock Classes="RowHint" Text="数值越大越柔和，0 为不模糊。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="RowSlider">
                    <Slider Minimum="0" Maximum="80" TickFrequency="5" Value="{Binding NowPlayingBackgroundBlurRadius, Mode=TwoWay}" />
                    <TextBlock Classes="RowValue" Text="{Binding NowPlayingBackgroundBlurRadiusDisplay}" />
                </StackPanel>
            </localControls:SettingsRow>
        </localControls:SettingsCard>
    </StackPanel>
</UserControl>
