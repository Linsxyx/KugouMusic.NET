<Project Sdk="Microsoft.NET.Sdk">
    <!-- The player's UI, view models and services, shared by the desktop and Android heads. -->
    <PropertyGroup>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFrameworks>
        <!-- Opt-in, so desktop builds never need the Android workload: -p:EnableAndroidTarget=true. -->
        <TargetFrameworks Condition="'$(EnableAndroidTarget)' == 'true'">$(TargetFrameworks);net10.0-android</TargetFrameworks>
        <AssemblyName>KugouAvaloniaPlayer.Shared</AssemblyName>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26</SupportedOSPlatformVersion>
    </PropertyGroup>

    <Import Project="..\KugouAvaloniaPlayer.Common.props" />

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="KugouAvaloniaPlayer" />
        <InternalsVisibleTo Include="KugouAvaloniaPlayer.Android" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AsyncImageLoader.Avalonia" />
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Controls.ItemsRepeater" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="MemoryPack" />
        <PackageReference Include="Microsoft.Data.Sqlite" Condition="'$(UseSystemSqlite)' != 'true'" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Condition="'$(UseSystemSqlite)' != 'true'" />
        <PackageReference Include="Microsoft.Data.Sqlite.Core" Condition="'$(UseSystemSqlite)' == 'true'" />
        <PackageReference Include="SQLitePCLRaw.bundle_sqlite3" Condition="'$(UseSystemSqlite)' == 'true'" />
        <!-- Keep the system SQLite provider explicitly versioned. -->
        <PackageReference Include="SQLitePCLRaw.provider.sqlite3" Condition="'$(UseSystemSqlite)' == 'true'" />
        <PackageReference Include="Pure.DI">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Serilog"/>
        <PackageReference Include="Serilog.Extensions.Logging"/>
        <PackageReference Include="Serilog.Sinks.Async" />
        <PackageReference Include="Serilog.Sinks.Console"/>
        <PackageReference Include="Serilog.Sinks.Debug"/>
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="SukiUI"/>
        <PackageReference Include="Svg.Controls.Skia.Avalonia"/>
        <!-- DPAPI calls are guarded by OperatingSystem.IsWindows(). -->
        <PackageReference Include="System.Security.Cryptography.ProtectedData"/>
        <PackageReference Include="ZLinq" />
        <PackageReference Include="z440.atl.core" />
    </ItemGroup>

    <!-- Desktop-only: native windowing (Win32Properties etc.), DBus/MPRIS and Velopack updates. -->
    <ItemGroup Condition="'$(KugouDesktop)' == 'true'">
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Tmds.DBus.Protocol"/>
        <PackageReference Include="Velopack" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Libraries\AvaloniaSilkEffects\AvaloniaSilkEffects.csproj"/>
        <ProjectReference Include="..\..\Libraries\AvaloniaLyrics\AvaloniaLyrics.csproj"/>
        <ProjectReference Include="..\..\Libraries\SimpleAudio\SimpleAudio.csproj"/>
        <ProjectReference Include="..\..\Libraries\KuGou.Net\KuGou.Net.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Views\MyPlaylistsView.axaml.cs">
            <DependentUpon>MyPlaylistsView.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\LocalMusicLibraryView.axaml.cs">
            <DependentUpon>LocalMusicLibraryView.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\DailyRecommendView.axaml.cs">
            <DependentUpon>DailyRecommendView.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Controls\LoginControl.axaml.cs">
            <DependentUpon>LoginControl.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\SettingView.axaml.cs">
            <DependentUpon>UserView.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\SingerView.axaml.cs">
            <DependentUpon>SingerView.axaml</DependentUpon>
        </Compile>
        <Compile Update="Controls\MediaCard.axaml.cs">
            <DependentUpon>MediaCard.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\DiscoverView.axaml.cs">
            <DependentUpon>DiscoverView.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\DesktopLyricLockOverlayWindow.axaml.cs">
          <DependentUpon>DesktopLyricLockOverlayWindow.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\EqSettingsView.axaml.cs">
          <DependentUpon>EqSettingsView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\NowPlayingView.axaml.cs">
          <DependentUpon>NowPlayingView.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\NowPlayingView.MoreFlyout.cs">
          <DependentUpon>NowPlayingView.axaml</DependentUpon>
        </Compile>
        <Compile Update="Controls\TrackPlaylistSearchDialog.axaml.cs">
          <DependentUpon>TrackPlaylistSearchDialog.axaml</DependentUpon>
        </Compile>
        <Compile Update="Controls\LyricMatchDialog.axaml.cs">
          <DependentUpon>LyricMatchDialog.axaml</DependentUpon>
        </Compile>
    </ItemGroup>
</Project>
